{
  "id": "logo_3d",
  "version": 1,
  "name": {
    "fa": "لوگوی سه‌بعدی",
    "en": "3D logo"
  },
  "description": {
    "fa": "تصویرِ لوگو (PNG/JPG/WebP، ترجیحاً با زمینهٔ شفاف) را برجسته می‌کند؛ روی سطحِ جلو رنگِ اصلیِ برند می‌ماند",
    "en": "Extrudes a logo image (PNG/JPG/WebP, ideally transparent) into a 3D object; the front keeps the brand colours."
  },
  "builder": "logo3d",
  "min_engine": "1.3.0",
  "order": 22,
  "ai": false,
  "tags": [
    "logo"
  ],
  "dimensions": [
    0.4,
    0.04,
    0.4
  ],
  "grasp": {
    "height": 0.5,
    "radius": 0.035,
    "curl": 0.8,
    "preset": "grip",
    "azimuth": 35,
    "tilt": 8,
    "gap": 0.006
  },
  "params": {
    "logo_image": {
      "type": "file",
      "label": "تصویرِ لوگو",
      "required": true
    },
    "width_m": {
      "type": "number",
      "default": 0.4,
      "min": 0.02,
      "max": 6.0,
      "label": "پهنا (متر)"
    },
    "depth_m": {
      "type": "number",
      "default": 0.04,
      "min": 0.002,
      "max": 0.5,
      "label": "ضخامت (متر)"
    },
    "bevel_m": {
      "type": "number",
      "default": 0.004,
      "min": 0.0,
      "max": 0.05,
      "label": "پخِ لبه (متر)"
    },
    "finish": {
      "type": "enum",
      "values": [
        "gold",
        "rose_gold",
        "copper",
        "chrome",
        "brushed_steel",
        "brushed_aluminium",
        "titanium",
        "black_gloss",
        "white_gloss",
        "matte",
        "soft_touch",
        "glass",
        "frosted_glass",
        "carbon",
        "neon"
      ],
      "default": "white_gloss",
      "label": "جنسِ بدنه"
    },
    "use_color": {
      "type": "bool",
      "default": false,
      "label": "رنگِ دلخواه برای بدنه"
    },
    "color": {
      "type": "color",
      "default": "#f6f4f0",
      "label": "رنگِ بدنه"
    },
    "face": {
      "type": "enum",
      "values": [
        "image",
        "none"
      ],
      "default": "image",
      "label": "روی سطحِ جلو"
    },
    "invert": {
      "type": "bool",
      "default": false,
      "label": "معکوس کردنِ شکل (لوگوی روشن روی زمینهٔ تیره)"
    },
    "glow": {
      "type": "number",
      "default": 6.0,
      "min": 0.5,
      "max": 40.0,
      "label": "شدتِ نورِ نئون"
    }
  },
  "license": "UpMarket 3D (procedural, own)"
}
