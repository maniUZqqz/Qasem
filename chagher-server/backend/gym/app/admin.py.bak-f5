            'fields': ('image', 'exercise', 'thumb_tag'),
            'description': 'اگر عکسِ خودتان را بگذارید همان نشان داده می‌شود؛ وگرنه '
                           'عکسِ حرکتِ نمونه از کتابخانه استفاده می‌شود.'
        }),
        ('دیگر', {'fields': ('notes', 'created_at', 'updated_at')}),
    )

    @admin.display(description='عکس')
    def thumb_tag(self, obj):
        url = obj.display_image_url()
        if not url:
            return '—'
        return format_html('<img src="{}" style="height:52px;border-radius:6px">', url)

    @admin.display(description='نام‌های دیگر')
    def alias_preview(self, obj):
        items = obj.alias_list()
        return '، '.join(items[:3]) + ('…' if len(items) > 3 else '') if items else '—'

    @admin.display(description='عکس دارد', boolean=True)
    def has_image(self, obj):
        return bool(obj.display_image_url())

    @admin.action(description='فعال‌کردن')
    def activate(self, request, queryset):
        n = queryset.update(is_active=True)
        self.message_user(request, '%d دستگاه فعال شد.' % n)

    @admin.action(description='غیرفعال‌کردن')
    def deactivate(self, request, queryset):
        n = queryset.update(is_active=False)
        self.message_user(request, '%d دستگاه غیرفعال شد.' % n)

    @admin.action(description='پرکردنِ عکس از کتابخانهٔ حرکت‌ها')
    def fill_images_from_library(self, request, queryset):
        from .equipment_catalog import attach_exercise
        done = 0
        for row in queryset:
            if attach_exercise(row):
                done += 1
        self.message_user(request, '%d دستگاه عکس گرفت.' % done)


