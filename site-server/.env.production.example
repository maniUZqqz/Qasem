# UpMarket — production environment.
#
#   cp .env.production.example .env
#   # fill in the values marked REQUIRED
#   docker compose up -d --build
#
# This file is read by docker-compose and passed to the backend containers.
# Never commit the filled-in .env.

# ---- REQUIRED: secrets ---------------------------------------------------
# Long random value. JWTs are signed with it, so changing it logs everyone out.
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=

# Database password. The DATABASE_URL is assembled from this in compose.
POSTGRES_PASSWORD=

# ---- REQUIRED: where this is served from ---------------------------------
DJANGO_DEBUG=false
# Comma-separated. Not "*" in production — that disables Host header checking.
DJANGO_ALLOWED_HOSTS=upmarket.ir,www.upmarket.ir
CSRF_TRUSTED_ORIGINS=https://upmarket.ir,https://www.upmarket.ir
CORS_ALLOWED_ORIGINS=https://upmarket.ir

PUBLIC_SITE_URL=https://upmarket.ir
PUBLIC_API_BASE=https://upmarket.ir
PUBLIC_PANEL_URL=https://upmarket.ir/panel

# ---- database ------------------------------------------------------------
POSTGRES_DB=upmarket
POSTGRES_USER=upmarket
# How long a connection is reused. Higher means fewer handshakes and more
# idle connections held open.
DB_CONN_MAX_AGE=60

# ---- HTTPS ---------------------------------------------------------------
# Turn these on once a certificate is actually in front of nginx. Enabling
# SSL redirect without a certificate makes the site unreachable.
SECURE_SSL_REDIRECT=false
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false
SECURE_HSTS_SECONDS=0

HTTP_PORT=80

# ---- AI: local GPU box, or an API ---------------------------------------
# This stack has no GPU. Either point at the machine that does:
OLLAMA_BASE_URL=http://192.168.1.50:11434
COMFYUI_BASE_URL=http://192.168.1.50:8188
#
# ...or skip local models entirely by setting an OpenAI-compatible endpoint,
# in which case Ollama and ComfyUI are never called:
AI_API_BASE_URL=
AI_API_KEY=
AI_API_MODEL_TEXT=gpt-4o-mini
AI_API_MODEL_VISION=gpt-4o-mini

# ---- which engine runs what ------------------------------------------------
# Asked once by the launcher (`python manage.py aisetup`) and written here.
# Each capability is separate: whatever goes to an API, its local engine is
# never started.
#
#   AI_MODE_TEXT   local -> Ollama          api -> AI_API_BASE_URL below
#   AI_MODE_IMAGE  local -> ComfyUI (FLUX)  api -> MEDIA_API_* below
#   AI_MODE_VIDEO  local -> ComfyUI (Wan)   api -> MEDIA_API_* below
#
# Vision rides with text: same Ollama, same choice.
# "api" without the matching credentials falls back to local, so the launcher
# never skips an engine the product still needs.
AI_MODE_TEXT=local
AI_MODE_IMAGE=local
AI_MODE_VIDEO=local

# Image/video over an API (Replicate-style prediction endpoint).
MEDIA_API_BASE_URL=https://api.replicate.com/v1/predictions
MEDIA_API_TOKEN=
MEDIA_API_MODEL_IMAGE=
MEDIA_API_MODEL_VIDEO=
MEDIA_API_TIMEOUT=900

# ---- data policy ----------------------------------------------------------
# What a store gets before its owner chooses (apps.ai.StoreAIPolicy lets each
# store override this, and the panel shows them what it means).
#
#   HYBRID             any active provider may answer  (default; what every
#                      install did before the policy layer existed)
#   APPROVED_EXTERNAL  only providers ticked "approved" in the admin
#   LOCAL_ONLY         nothing leaves this server. A job with no local model
#                      FAILS with a clear message instead of quietly calling
#                      an API. Narration also stops: both TTS engines are
#                      external (Microsoft / Google) and there is no local
#                      Persian voice yet.
#
# Set LOCAL_ONLY if you promise every customer that their data stays here.
AI_DEFAULT_POLICY=HYBRID

# ---- email (بازیابی رمز) --------------------------------------------------
# The ONLY thing email is used for: letting someone who forgot their password
# back in. Leave EMAIL_HOST empty and the reset message is printed to the
# server log instead of being sent — fine for development, and the settings
# refuse to start in production without it, because a silently discarded
# reset email means the customer waits for a link that never arrives.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@upmarket.ir
# How long a reset link stays usable, in seconds. 86400 = one day.
PASSWORD_RESET_TIMEOUT=86400
THROTTLE_PASSWORD_RESET=5/hour

# ---- payments ------------------------------------------------------------
# 36-character UUID from the ZarinPal panel. Empty = bank transfer only.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false
MANUAL_ACCOUNT_INFO=
PAYMENT_CALLBACK_BASE=https://upmarket.ir
PANEL_URL=https://upmarket.ir/panel
BILLING_GRACE_DAYS=3

# ---- publishing ----------------------------------------------------------
NOVINHUB_TOKEN=
N8N_WEBHOOK_URL=

# ---- operations ----------------------------------------------------------
LOG_LEVEL=INFO
MAX_UPLOAD_MB=10
BACKUP_KEEP_DAYS=14
THROTTLE_ANON=30/minute
THROTTLE_USER=240/minute
