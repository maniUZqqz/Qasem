# ============================================================================
# حسابداری — کاملاً فقط خواندنی
#
# این بخش عمداً با بقیه پنل ادمین فرق دارد: هیچ افزودن، ویرایش یا حذفی
# ندارد. دلیلش این است که دو شریک باید بتوانند به همین اعداد استناد کنند و
# هیچ‌کس نتواند دستی عددی را جابه‌جا کند.
# ============================================================================

@admin.register(LedgerEntry)
class LedgerEntryAdmin(ReadOnlyAdminMixin, admin.ModelAdmin):
    """دفتر حساب — سطرها فقط افزوده می‌شوند و هرگز ویرایش/حذف نمی‌شوند."""
    list_display = [
        'created_at', 'entry_type', 'user', 'counterparty',
        'tokens_display', 'amount_display', 'reference', 'description',
    ]
    list_filter = ['entry_type', 'created_at']
    search_fields = [
        'user__phone_number', 'user__gym_name', 'reference', 'description',
        'counterparty__phone_number',
    ]
    date_hierarchy = 'created_at'
    list_per_page = 50
    list_select_related = ['user', 'counterparty']

    @admin.display(description='توکن', ordering='tokens')
    def tokens_display(self, obj):
        if not obj.tokens:
            return '-'
        color = '#15803d' if obj.tokens > 0 else '#b91c1c'
        return format_html(
            '<span style="color:{};font-weight:700">{:+,}</span>', color, obj.tokens
        )

    @admin.display(description='مبلغ (تومان)', ordering='amount')
    def amount_display(self, obj):
        if not obj.amount:
            return '-'
        color = '#15803d' if obj.amount > 0 else '#b91c1c'
        sign = '+' if obj.amount > 0 else '-'
        return format_html(
            '<span style="color:{};font-weight:700">{}{}</span>',
            color, sign, _toman(abs(obj.amount)),
        )


@admin.register(AccountStatement)
class AccountStatementAdmin(ReadOnlyAdminMixin, admin.ModelAdmin):
    """صورت‌حساب هر کاربر: چقدر خریده، چقدر مصرف کرده، چقدر مانده."""
    list_display = [
        'phone_number', 'gym_name', 'account_type',
        'paid_amount_display', 'tokens_bought_display', 'tokens_spent_display',
        'programs_count', 'ai_cost_display', 'current_balance_display',
    ]
    list_filter = ['account_type']
    search_fields = ['phone_number', 'gym_name']
    list_per_page = 40

    fieldsets = (
        ('کاربر', {'fields': ('phone_number', 'gym_name', 'account_type')}),
        ('خلاصه حساب', {'fields': ('statement_summary',)}),
    )
    readonly_fields = ['phone_number', 'gym_name', 'account_type', 'statement_summary']

    def get_queryset(self, request):
        qs = super().get_queryset(request)
        return qs.annotate(
            _paid_amount=Sum(
                'token_purchases__final_price',
                filter=Q(token_purchases__status='paid'),
            ),
            _tokens_bought=Sum(
                'token_purchases__token_amount',
                filter=Q(token_purchases__status='paid'),
            ),
            _tokens_spent=Sum('programs__tokens_consumed'),
            _programs=Count('programs', distinct=True),
            _ai_cost=Sum('programs__ai_cost'),
        )

    @admin.display(description='مبلغ پرداختی (تومان)', ordering='_paid_amount')
    def paid_amount_display(self, obj):
        return _toman(getattr(obj, '_paid_amount', 0))

    @admin.display(description='توکن خریداری‌شده', ordering='_tokens_bought')
    def tokens_bought_display(self, obj):
        return f"{getattr(obj, '_tokens_bought', 0) or 0:,}"

    @admin.display(description='توکن مصرف‌شده', ordering='_tokens_spent')
    def tokens_spent_display(self, obj):
        return f"{getattr(obj, '_tokens_spent', 0) or 0:,}"

    @admin.display(description='تعداد برنامه', ordering='_programs')
    def programs_count(self, obj):
        return getattr(obj, '_programs', 0) or 0

    @admin.display(description='هزینه هوش مصنوعی (تومان)', ordering='_ai_cost')
    def ai_cost_display(self, obj):
        return _toman(getattr(obj, '_ai_cost', 0))

    @admin.display(description='موجودی فعلی')
    def current_balance_display(self, obj):
        return f"{obj.get_effective_token_balance():,}"

    @admin.display(description='خلاصه')
    def statement_summary(self, obj):
        paid = TokenPurchase.objects.filter(user=obj, status='paid')
        total_paid = paid.aggregate(v=Sum('final_price'))['v'] or Decimal('0')
        tokens_bought = paid.aggregate(v=Sum('token_amount'))['v'] or 0
        programs = ClientProgram.objects.filter(user=obj)
        tokens_spent = programs.aggregate(v=Sum('tokens_consumed'))['v'] or 0
        ai_cost = programs.aggregate(v=Sum('ai_cost'))['v'] or Decimal('0')
        commission = DiscountCodeUsage.objects.filter(
            discount_code__creator=obj
        ).aggregate(v=Sum('commission_amount'))['v'] or Decimal('0')

        rows = [
            ('مبلغ پرداختی (تومان)', _toman(total_paid)),
            ('توکن خریداری‌شده', f"{tokens_bought:,}"),
            ('توکن مصرف‌شده', f"{tokens_spent:,}"),
            ('موجودی فعلی توکن', f"{obj.get_effective_token_balance():,}"),
            ('تعداد برنامه ساخته‌شده', f"{programs.count():,}"),
            ('هزینه واقعی هوش مصنوعی (تومان)', _toman(ai_cost)),
            ('کمیسیون دریافتی از کدهای تخفیف (تومان)', _toman(commission)),
            ('سود ناخالص این کاربر (تومان)', _toman(total_paid - ai_cost)),
        ]
        body = ''.join(
            '<tr><th style="text-align:right;padding:6px 12px;background:#f3f6fb;'
            'border:1px solid #e2e8f0;">{}</th>'
            '<td style="padding:6px 12px;border:1px solid #e2e8f0;">{}</td></tr>'.format(k, v)
            for k, v in rows
        )
        return mark_safe(
            '<table style="border-collapse:collapse;direction:rtl;font-family:Tahoma;'
            'font-size:13px;">' + body + '</table>'
        )


# ============================================================================
# بهای تمام‌شده — چقدر توکن مدل خرج می‌کنیم و در برابرش چقدر می‌فروشیم
# ============================================================================

def _tokens(value):
    """نمایش تعداد توکن با جداکننده هزارگان."""
    try:
        return f"{int(value or 0):,}"
    except (TypeError, ValueError):
        return '0'


