# ==================== Equipment Suggestion Views ====================

@extend_schema(tags=['Equipment'])
class EquipmentSuggestionView(APIView):
    """پیشنهاد دستگاه‌ها و حرکات پرکاربرد"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        parameters=[
            OpenApiParameter(name='training_place', type=OpenApiTypes.STR,
                             description='فیلتر محیط تمرین: public_gym | home_basic | home_none'),
            OpenApiParameter(name='muscle_group', type=OpenApiTypes.STR,
                             description='فیلتر گروه عضلانی (مثلاً: سینه)'),
            OpenApiParameter(name='search', type=OpenApiTypes.STR, description='جستجو در نام'),
            OpenApiParameter(name='limit', type=OpenApiTypes.INT, description='تعداد نتیجه (پیش‌فرض 20)'),
        ],
        responses={200: {'type': 'object'}},
        description="""پیشنهاد دستگاه‌ها و حرکات بر اساس محبوبیت در کل سامانه.

        - هرچه دستگاهی را کاربران بیشتری ثبت کرده باشند، بالاتر پیشنهاد می‌شود
          (`source: community` همراه با `usage_count`).
        - تا وقتی داده واقعی کم است، کاتالوگ پایه جای خالی را پر می‌کند
          (`source: starter`).
        - برای مربی: `already_added` نشان می‌دهد قبلاً ثبتش کرده یا نه.
        - برای کاربر شخصی: با `training_place` فقط حرکات قابل اجرا در محیط او
          برگردانده می‌شود (مثلاً خانه بدون تجهیزات → فقط وزن بدن).
        """
    )
    def get(self, request):
        suggestions = get_suggestions(
            user=request.user,
            training_place=request.query_params.get('training_place'),
            muscle_group=request.query_params.get('muscle_group'),
            search=request.query_params.get('search'),
            limit=request.query_params.get('limit', 20),
        )
        return Response({
            'count': len(suggestions),
            'muscle_groups': catalog_muscle_groups(),
            'results': suggestions,
        })


@extend_schema(tags=['Equipment'])
class EquipmentBulkAddView(APIView):
    """افزودن گروهی دستگاه‌های پیشنهادی به باشگاه (فقط مربی)"""
    permission_classes = [IsCoach]

    @extend_schema(
        request={'application/json': {'type': 'object', 'properties': {
            'names': {'type': 'array', 'items': {'type': 'string'}}
        }}},
        responses={201: {'type': 'object'}},
        description="""افزودن چند دستگاه پیشنهادی به تجهیزات باشگاه با یک درخواست.
        دستگاه‌هایی که قبلاً ثبت شده‌اند نادیده گرفته می‌شوند (تکراری ساخته نمی‌شود).
        """
    )
    def post(self, request):
        names = request.data.get('names')
        if not isinstance(names, list) or not names:
            return Response({'error': 'فهرست names الزامی است.'},
                            status=status.HTTP_400_BAD_REQUEST)

        # نگاشت نام به گروه عضلانی از کاتالوگ پایه
        from .exercise_catalog import STARTER_CATALOG
        catalog = {item['name']: item for item in STARTER_CATALOG}

        existing = set(
            Equipment.objects.filter(user=request.user).values_list('name', flat=True)
        )

        created, skipped = [], []
        with transaction.atomic():
            for raw in names:
                name = (raw or '').strip()
                if not name:
                    continue
                if name in existing:
                    skipped.append(name)
                    continue
                info = catalog.get(name, {})
                Equipment.objects.create(
                    user=request.user,
                    name=name,
                    muscle_group=info.get('muscle_group', ''),
                )
                existing.add(name)
                created.append(name)

        logger.info(
            f"Bulk equipment add by {request.user.phone_number}: "
            f"{len(created)} created, {len(skipped)} skipped"
        )
        return Response({
            'created': created,
            'skipped': skipped,
            'message': f'{len(created)} دستگاه اضافه شد.'
        }, status=status.HTTP_201_CREATED)


# ==================== Program Views ====================

@extend_schema(tags=['Programs'])
class GenerateProgramView(APIView):
    """تولید برنامه ورزشی و غذایی با هوش مصنوعی"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        request=GenerateProgramSerializer,
        responses={201: ClientProgramSerializer},
        description="""تولید برنامه ورزشی و غذایی جدید.
        - هزینه: هر دو ۵۰ توکن | فقط ورزشی یا فقط غذایی ۲۵ توکن
        - اگر generate_pdf=true باشد، فایل PDF به صورت دانلود در پاسخ برگردانده می‌شود
        - pdf_type: 'both', 'workout', 'meal' (پیش‌فرض: both)
        - برنامه متنی همیشه در دیتابیس ذخیره می‌شود
        """
    )
    def post(self, request):
        serializer = GenerateProgramSerializer(data=request.data)
        if not serializer.is_valid():
            return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

        # هزینه بر اساس نوع برنامه (both: 50 | workout: 25 | meal: 25)
        program_type = serializer.validated_data.get('program_type', 'both')
        required_tokens = PROGRAM_TYPE_COSTS[program_type]

        # قاعده‌های قیمتِ ادمین اول حرف می‌زنند؛ اگر هیچ قاعده‌ای نخورد،
        # رفتارِ قدیمی (۵ برنامهٔ رایگان) دست‌نخورده ادامه پیدا می‌کند.
        from .pricing import resolve as _price, PROGRAM_TYPE_TO_FEATURE
        _rule_note = ''
        _d = _price(request.user, PROGRAM_TYPE_TO_FEATURE.get(program_type, 'ai_both'))
        if _d is not None:
            if _d.mode == 'blocked':
                return Response({
                    'error': _d.rule.blocked_message or 'این امکان الان در دسترس نیست.',
                    'rule': _d.rule.title,
                }, status=status.HTTP_402_PAYMENT_REQUIRED)
            required_tokens = _d.cost
            _rule_note = ' [قاعده: %s]' % _d.rule.title
        else:
            # سهمیهٔ رایگانِ هوش مصنوعی (خواستهٔ مالک: ۵ برنامهٔ اولِ هر مربی).
            # تعدادش در «تنظیمات سامانه» است، پس بدونِ تغییرِ کد عوض می‌شود.
            ai_free_left = request.user.ai_free_left()
            if ai_free_left > 0:
                required_tokens = 0

        # محیط تمرین: کاربر شخصی تجهیزات ثبت‌شده ندارد، پس باید محیطش را مشخص کند.
        # برای مربی/ورزشکار باشگاه، پیش‌فرض همان تجهیزات ثبت‌شده باشگاه است.
        training_place = serializer.validated_data.get('training_place')
        if request.user.is_personal:
            # ورزشکارِ شخصی‌ای که باشگاهش را اسکن کرده، دستگاه‌های خودش را دارد؛
            # پس «تجهیزاتِ ثبت‌شده» برای او هم معنا دارد و دیگر رد نمی‌شود.
            has_own_equipment = Equipment.objects.filter(user=request.user).exists()
            if (training_place == ClientProgram.TRAINING_PLACE_GYM_EQUIPMENT
                    and has_own_equipment):
                pass
            elif not training_place or training_place == ClientProgram.TRAINING_PLACE_GYM_EQUIPMENT:
                return Response({
                    'error': 'محیط تمرین را مشخص کنید.',
                    'training_place_choices': [
                        {'value': v, 'label': l}
                        for v, l in ClientProgram.TRAINING_PLACE_CHOICES
                        if v != ClientProgram.TRAINING_PLACE_GYM_EQUIPMENT
                    ]
                }, status=status.HTTP_400_BAD_REQUEST)
        elif training_place and training_place != ClientProgram.TRAINING_PLACE_GYM_EQUIPMENT:
            # مربی هم می‌تواند برنامه خانگی برای شاگردش بسازد — مجاز است
            pass

        # بررسی توکن کافی
        if required_tokens and not request.user.has_enough_tokens(required_tokens):
            return Response({
                'error': 'توکن کافی ندارید.',
                'required_tokens': required_tokens,
                'current_balance': request.user.token_balance
            }, status=status.HTTP_402_PAYMENT_REQUIRED)

        # کسر توکن — چک قطعی موجودی زیر قفل انجام می‌شود
        if required_tokens and not request.user.deduct_tokens(required_tokens):
            return Response({
                'error': 'توکن کافی ندارید.',
                'required_tokens': required_tokens,
                'current_balance': request.user.get_effective_token_balance()
            }, status=status.HTTP_402_PAYMENT_REQUIRED)

        # ایجاد رکورد برنامه
        program_data = serializer.validated_data.copy()

        # کاربرِ شخصی یک‌بار پروفایلش را پر کرده؛ هر چه در فرم نیامده از آن
        # برداشته می‌شود تا هر بار قد و وزن و آسیب‌ها دوباره پرسیده نشود.
        if request.user.is_personal:
            profile = AthleteProfile.objects.filter(user=request.user).first()
            if profile:
                untouched = [f for f in profile.PROGRAM_FIELDS if f not in request.data]
                profile.apply_to(program_data, force=untouched)
        generate_pdf_flag = program_data.pop('generate_pdf', False)
        pdf_type = program_data.pop('pdf_type', 'both')

        # PDF فقط برای بخش تولیدشده معنا دارد
        if program_type != 'both':
            pdf_type = program_type

        client = ClientProgram.objects.create(
            user=request.user,
            tokens_consumed=required_tokens,
            **program_data  # شامل program_type و exercise_history
        )

        try:
            # تولید برنامه با هوش مصنوعی — فقط بخش درخواستی.
            # کال شبکه‌ای عمداً خارج از تراکنش دیتابیس است تا قفل نوشتن
            # به اندازه تاخیر مدل نگه داشته نشود.
            workout, meal_plan, usage = generate_program(client.id, program_type)

            client.generated_workout = workout
            client.generated_meal_plan = meal_plan
            ai_cost = client.record_ai_usage(
                usage.model_name, usage.input_tokens, usage.output_tokens,
                config=usage.provider_config,
            )
            client.save()
        except Exception:
            # جبران: حذف رکورد ناتمام و بازگشت توکن‌ها
            logger.exception(
                f"Error generating program for user {request.user.phone_number}"
            )
            client.delete()
            request.user.add_tokens(required_tokens)
            LedgerEntry.record(
                LedgerEntry.TYPE_TOKEN_REFUND,
                user=request.user,
                tokens=required_tokens,
                description='بازگشت توکن پس از خطای تولید برنامه',
            )
            return Response({
                'error': 'خطا در تولید برنامه. توکن‌های شما بازگردانده شد؛ لطفاً دوباره تلاش کنید.'
            }, status=status.HTTP_500_INTERNAL_SERVER_ERROR)

        # سطر تفکیکی بهای تمام‌شده — کنار دفتر حساب و مستقل از آن.
        # دفتر حساب فقط «چقدر خرج شد» را می‌گوید؛ این سطر می‌گوید آن خرج
        # بابت چه نوع عملیاتی و در برابر چه درآمدی بوده است.
        AIUsageLog.record(
            program=client,
            user=request.user,
            operation=AIUsageLog.OP_GENERATE,
            program_type=program_type,
            usage=usage,
            tokens_charged=required_tokens,
            cost=ai_cost,
        )

        LedgerEntry.record(
            LedgerEntry.TYPE_TOKEN_SPEND,
            user=request.user,
            tokens=-required_tokens,
            reference=f'program#{client.id}',
            description=f'تولید برنامه ({client.get_program_type_display()}){_rule_note}',
        )
        if ai_cost:
            LedgerEntry.record(
                LedgerEntry.TYPE_AI_COST,
                user=request.user,
                amount=-ai_cost,
                reference=f'program#{client.id}',
                description=f'هزینه مدل {usage.model_name}',
            )

        logger.info(
            f"Program #{client.id} generated for user {request.user.phone_number} "
            f"(type={program_type}, {required_tokens} tokens consumed, "
            f"balance: {request.user.token_balance}, ai_cost={ai_cost})"
        )

        # اگر PDF درخواست شده، تولید و برگرداندن آن
        if generate_pdf_flag:
            try:
                if pdf_type == 'workout':
                    content, _ = generate_workout_pdf(client)
                    filename = f"workout_{client.name}_{client.id}.pdf"
                elif pdf_type == 'meal':
                    content, _ = generate_meal_pdf(client)
                    filename = f"meal_{client.name}_{client.id}.pdf"
                else:  # 'both'
                    content, _ = generate_pdf(client)
                    filename = f"{client.name}_{client.id}.pdf"
            except Exception:
                # برنامه تولید و ذخیره شده؛ فقط PDF شکست خورده — برنامه را از دست نده
                logger.exception(f"PDF generation failed for program #{client.id}")
                return Response({
                    'program': ClientProgramSerializer(client).data,
                    'remaining_tokens': request.user.token_balance,
                    'message': 'برنامه تولید و ذخیره شد اما ساخت PDF ناموفق بود. '
                               'از مسیر دانلود PDF برنامه دوباره تلاش کنید.'
                }, status=status.HTTP_201_CREATED)

            response = HttpResponse(content, content_type='application/pdf')
            response['Content-Disposition'] = f'attachment; filename="{filename}"'
            return response

        # بازگشت JSON
        return Response({
            'program': ClientProgramSerializer(client).data,
            'remaining_tokens': request.user.token_balance,
            'message': 'برنامه با موفقیت تولید شد.'
        }, status=status.HTTP_201_CREATED)




@extend_schema(tags=['Programs'])
class EditProgramView(APIView):
    """ویرایش برنامه با بازخورد"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        request=EditProgramSerializer,
        responses={200: ClientProgramSerializer},
        parameters=[
            OpenApiParameter(
                name='program_id',
                type=OpenApiTypes.INT,
                location=OpenApiParameter.PATH,
                description='شناسه برنامه'
            )
        ],
        description="""ویرایش برنامه موجود با بازخورد.
        - هزینه: 25 توکن (از حساب کاربری که درخواست ویرایش را می‌زند کسر می‌شود)
        - مربی می‌تواند برنامه‌ی ورزشکاران باشگاهش را هم ویرایش کند (نه فقط برنامه‌های خودش)
        - اگر generate_pdf=true باشد، فایل PDF به صورت دانلود در پاسخ برگردانده می‌شود
        - pdf_type: 'both', 'workout', 'meal' (پیش‌فرض: both)
        """
    )
    def post(self, request, program_id):
        try:
            client = _accessible_programs_queryset(request.user).get(id=program_id)
        except ClientProgram.DoesNotExist:
            return Response({'error': 'برنامه یافت نشد.'}, status=status.HTTP_404_NOT_FOUND)

        serializer = EditProgramSerializer(data=request.data)
        if not serializer.is_valid():
            return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

        # بررسی توکن کافی — قاعده‌های ادمین اول
        required_tokens = TOKEN_COSTS['edit_program']
        from .pricing import resolve as _price, F_AI_EDIT
        _d = _price(request.user, F_AI_EDIT)
        if _d is not None:
            if _d.mode == 'blocked':
                return Response({
                    'error': _d.rule.blocked_message or 'ویرایش الان در دسترس نیست.',
                    'rule': _d.rule.title,
                }, status=status.HTTP_402_PAYMENT_REQUIRED)
            required_tokens = _d.cost
        if required_tokens and not request.user.has_enough_tokens(required_tokens):
            return Response({
                'error': 'توکن کافی ندارید.',
                'required_tokens': required_tokens,
                'current_balance': request.user.token_balance
            }, status=status.HTTP_402_PAYMENT_REQUIRED)

        # کسر توکن — چک قطعی موجودی زیر قفل انجام می‌شود
        if not request.user.deduct_tokens(required_tokens):
            return Response({
                'error': 'توکن کافی ندارید.',
                'required_tokens': required_tokens,
                'current_balance': request.user.get_effective_token_balance()
            }, status=status.HTTP_402_PAYMENT_REQUIRED)

        feedback = serializer.validated_data['feedback']
        generate_pdf_flag = serializer.validated_data.get('generate_pdf', False)
        pdf_type = serializer.validated_data.get('pdf_type', 'both')

        try:
            # کال شبکه‌ای هوش مصنوعی خارج از تراکنش دیتابیس
            new_workout, new_meal, usage = edit_program_with_feedback(client, feedback)

            client.tokens_consumed += required_tokens
            client.generated_workout = new_workout
            client.generated_meal_plan = new_meal
            ai_cost = client.record_ai_usage(
                usage.model_name, usage.input_tokens, usage.output_tokens,
                config=usage.provider_config,
            )
            client.save()
        except Exception:
            # جبران: بازگشت توکن‌ها؛ برنامه قبلی دست‌نخورده مانده است
            logger.exception(f"Error editing program {program_id}")
            request.user.add_tokens(required_tokens)
            LedgerEntry.record(
                LedgerEntry.TYPE_TOKEN_REFUND,
                user=request.user,
                tokens=required_tokens,
                reference=f'program#{program_id}',
                description='بازگشت توکن پس از خطای ویرایش برنامه',
            )
            return Response({
                'error': 'خطا در ویرایش برنامه. توکن‌های شما بازگردانده شد؛ لطفاً دوباره تلاش کنید.'
            }, status=status.HTTP_500_INTERNAL_SERVER_ERROR)

        AIUsageLog.record(
            program=client,
            user=request.user,
            operation=AIUsageLog.OP_EDIT,
            program_type=client.program_type,
            usage=usage,
            tokens_charged=required_tokens,
            cost=ai_cost,
        )

        LedgerEntry.record(
            LedgerEntry.TYPE_TOKEN_SPEND,
            user=request.user,
            tokens=-required_tokens,
            reference=f'program#{client.id}',
            description='ویرایش برنامه با بازخورد',
        )
        if ai_cost:
            LedgerEntry.record(
                LedgerEntry.TYPE_AI_COST,
                user=request.user,
                amount=-ai_cost,
                reference=f'program#{client.id}',
                description=f'هزینه مدل {usage.model_name} (ویرایش)',
            )

        logger.info(
            f"Program #{client.id} edited for user {request.user.phone_number} "
            f"({required_tokens} tokens consumed, balance: {request.user.token_balance}, "
            f"ai_cost={ai_cost})"
        )

        # اگر PDF درخواست شده
        if generate_pdf_flag:
            # PDF فقط برای بخش‌های موجود برنامه معنا دارد
            if not client.generated_meal_plan and pdf_type in ('both', 'meal'):
                pdf_type = 'workout'
            elif not client.generated_workout and pdf_type in ('both', 'workout'):
                pdf_type = 'meal'

            try:
                if pdf_type == 'workout':
                    content, _ = generate_workout_pdf(client)
                    filename = f"workout_{client.name}_{client.id}.pdf"
                elif pdf_type == 'meal':
                    content, _ = generate_meal_pdf(client)
                    filename = f"meal_{client.name}_{client.id}.pdf"
                else:  # 'both'
                    content, _ = generate_pdf(client)
                    filename = f"{client.name}_{client.id}.pdf"
            except Exception:
                logger.exception(f"PDF generation failed for edited program #{client.id}")
                return Response({
                    'program': ClientProgramSerializer(client).data,
                    'remaining_tokens': request.user.token_balance,
                    'message': 'برنامه ویرایش و ذخیره شد اما ساخت PDF ناموفق بود. '
                               'از مسیر دانلود PDF برنامه دوباره تلاش کنید.'
                })

            response = HttpResponse(content, content_type='application/pdf')
            response['Content-Disposition'] = f'attachment; filename="{filename}"'
            return response

        # بازگشت JSON
        return Response({
            'program': ClientProgramSerializer(client).data,
            'remaining_tokens': request.user.token_balance,
            'message': 'برنامه با موفقیت ویرایش شد.'
        })




@extend_schema(tags=['Programs'])
class GeneratePDFView(APIView):
    """تولید PDF از برنامه موجود"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        responses={200: {'type': 'string', 'format': 'binary'}},
        parameters=[
            OpenApiParameter(
                name='program_id',
                type=OpenApiTypes.INT,
                location=OpenApiParameter.PATH,
                description='شناسه برنامه'
            )
        ],
        description="تولید فایل PDF از برنامه موجود و دانلود آن (بدون ذخیره در دیتابیس)"
    )
    def get(self, request, program_id):
        try:
            client = _accessible_programs_queryset(request.user).get(id=program_id)
        except ClientProgram.DoesNotExist:
            return Response({'error': 'برنامه یافت نشد.'}, status=status.HTTP_404_NOT_FOUND)

        if not client.generated_workout and not client.generated_meal_plan:
            return Response({'error': 'برنامه هنوز تولید نشده است.'}, status=status.HTTP_400_BAD_REQUEST)

        try:
            content, _ = generate_pdf(client)
        except Exception:
            logger.exception(f"Error generating PDF for program {program_id}")
            return Response({
                'error': 'خطا در تولید PDF. لطفاً دوباره تلاش کنید.'
            }, status=status.HTTP_500_INTERNAL_SERVER_ERROR)

        response = HttpResponse(content, content_type='application/pdf')
        response['Content-Disposition'] = f'attachment; filename="{client.name}_{client.id}.pdf"'
        return response




@extend_schema(tags=['Programs'])
class ProgramDetailView(APIView):
    """دریافت جزئیات برنامه"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        responses={200: ClientProgramSerializer},
        parameters=[
            OpenApiParameter(
                name='program_id',
                type=OpenApiTypes.INT,
                location=OpenApiParameter.PATH,
                description='شناسه برنامه'
            )
        ],
        description="دریافت متن کامل برنامه ورزشی و غذایی"
    )
    def get(self, request, program_id):
        try:
            client = _accessible_programs_queryset(request.user).get(id=program_id)
