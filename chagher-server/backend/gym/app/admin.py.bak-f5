@admin.register(GymClient)
class GymClientAdmin(admin.ModelAdmin):
    actions = ['reclaim_tokens_action']

    @admin.action(description='بازگرداندن توکن‌های رزروشده به مربی')
    def reclaim_tokens_action(self, request, queryset):
        total = 0
        count = 0
        for client in queryset:
            returned = client.reclaim_pending_tokens(reason='admin')
            if returned:
                total += returned
                count += 1
        if total:
            self.message_user(request, f'{total} توکن از {count} کد به مربیان بازگردانده شد.')
        else:
            self.message_user(request, 'هیچ توکن رزروشده‌ای برای بازگرداندن نبود.')

    """مدیریت مشتریان باشگاه"""
    list_display = ['name', 'access_code', 'access_code_status', 'gym_owner_name', 'gym_owner_phone', 'pending_tokens', 'is_used', 'client_user', 'created_at']
    list_filter = ['is_used', 'gender', 'created_at']
    search_fields = ['name', 'access_code', 'gym_owner__phone_number', 'gym_owner__gym_name']
    autocomplete_fields = ['gym_owner', 'client_user']
    readonly_fields = ['access_code', 'created_at', 'updated_at']

    @admin.display(description='وضعیت کد')
    def access_code_status(self, obj):
        if obj.access_code_expires_at is None:
            return 'دائمی'
        if obj.access_code_is_expired:
            return '✗ منقضی'
        return f"تا {obj.access_code_expires_at.strftime('%Y-%m-%d %H:%M')}"

    fieldsets = (
        ('باشگاه', {
            'fields': ('gym_owner',)
        }),
        ('کد دسترسی', {
            'fields': ('access_code', 'access_code_expires_at', 'pending_tokens', 'is_used', 'client_user'),
            'description': 'انقضای کد خالی = کد دائمی. کد منقضی‌شده نه فعال می‌شود و نه ورود مجدد می‌دهد.'
        }),
        ('اطلاعات مشتری', {
            'fields': ('name', 'age', 'gender', 'height', 'weight', 'goal')
        }),
        ('اطلاعات پزشکی', {
            'fields': ('injuries', 'food_allergies')
        }),
        ('تاریخ‌ها', {
            'fields': ('created_at', 'updated_at')
        }),
    )

    @admin.display(description='نام باشگاه')
    def gym_owner_name(self, obj):
        return obj.gym_owner.gym_name or '-'

    @admin.display(description='شماره مربی')
    def gym_owner_phone(self, obj):
        return obj.gym_owner.phone_number


