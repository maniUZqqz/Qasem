{
  "Video": {
    // پوشهٔ ffmpeg.exe و ffprobe.exe؛ خالی ⇒ خودش پیدا می‌کند (tools\ffmpeg\bin، PATH، نصبِ winget)
    "FFmpegDir": "",
    // کتابخانهٔ ویدیوها (data\videos) و LUTها (data\luts)؛ خالی ⇒ پوشهٔ data کنارِ پروژه
    "DataDir": "",
    // جدا از صدا (5600)، یابندهٔ رقیب (5610)، سرویسِ صدا (5620)، مشابه‌یاب (5650) و ویرایشگرِ عکس (5670)
    "HttpPort": 5680,
    // false ⇒ فقط همین کامپیوتر. true ⇒ همهٔ شبکه — آن‌وقت حتماً ApiKey بگذارید
    "LanAccess": false,
    // خالی ⇒ بی‌کلید. پر ⇒ هر درخواستِ /api باید سرآیندِ X-Api-Key (یا ?key=) داشته باشد
    "ApiKey": "",
    // بزرگ‌ترین فایلِ قابلِ بارگذاری (MB)
    "MaxUploadMB": 4096,
    // این مقدار جای خالی روی دیسک باید بماند؛ کمتر باشد بارگذاری و خروجی انجام نمی‌شود (MB)
    "MinFreeDiskMB": 1500,
    // ضلعِ کوچکِ پیش‌نمایشِ متحرک (پیکسل)
    "PreviewShort": 360,
    // ویرایشگرِ هوشمند: هر سرویسِ سازگار با OpenAI که عکس می‌پذیرد. کلید خالی ⇒ فقط تنظیمِ خودکارِ رایگان (بی اینترنت)
    "Ai": {
      "BaseUrl": "https://openrouter.ai/api/v1",
      "ApiKey": "",
      "Models": "auto-free",
      "MaxRounds": 2,
      "CellSide": 256
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
