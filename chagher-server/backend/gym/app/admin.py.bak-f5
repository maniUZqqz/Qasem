def _price_cross_check(obj):
    """«تعرفه» و «تنظیماتِ سامانه» با هم می‌خوانند؟ — همین‌جا نشان بده.

    بدونِ این، مالک در یک صفحه قیمت می‌گذارد و در صفحهٔ دیگر عددِ دیگری
    می‌ماند و هیچ‌کس متوجه نمی‌شود.
    """
    try:
        from .pricing import toman_per_token, program_price_toman
        from .views import live_token_costs
    except Exception:
        return '—'
    rate = toman_per_token()
    if rate is None:
        return format_html(
            '<b style="color:#b02a2a">هیچ تعرفهٔ فعالی نیست</b> — '
            'خریدِ توکن کار نمی‌کند. در «بسته توکن» یکی را فعال کن.')
    rows = []
    for key, label in (('generate_program', 'برنامهٔ کامل (ورزشی+غذایی)'),
                       ('generate_workout_only', 'فقط ورزشی'),
                       ('generate_meal_only', 'فقط غذایی'),
                       ('edit_program', 'ویرایش')):
        tk = live_token_costs()[key]
        rows.append('<tr><td>%s</td><td>%d توکن</td><td><b>%s تومان</b></td></tr>'
                    % (label, tk, '{:,}'.format(program_price_toman(tk) or 0)))
    admin_val = int(obj.ai_program_price or 0)
    real = program_price_toman(live_token_costs()['generate_program']) or 0
    if not admin_val:
        verdict = ('<div style="color:#15803d">عددِ بالا خالی است، پس همین '
                   'قیمتِ محاسبه‌شده به اپ می‌رود. ✓</div>')
    elif admin_val == real:
        verdict = '<div style="color:#15803d">با تعرفه می‌خواند. ✓</div>'
    else:
        verdict = ('<div style="color:#b02a2a"><b>⚠ نمی‌خواند:</b> در اپ '
                   '%s تومان نشان داده می‌شود ولی مشتری عملاً %s تومان '
                   'توکن می‌خرد. یا این عدد را درست کن یا خالی بگذار تا '
                   'خودکار حساب شود.</div>'
                   % ('{:,}'.format(admin_val), '{:,}'.format(real)))
    return format_html(
        '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;'
        'padding:12px;max-width:620px;line-height:1.9">'
        '<b style="color:#163F75">قیمتِ واقعی از روی «بسته توکن»</b> '
        '(هر توکن {} تومان):'
        '<table style="margin:8px 0;border-collapse:collapse" border="1" '
        'cellpadding="6">{}</table>{}</div>',
        '{:,.0f}'.format(rate), mark_safe(''.join(rows)), mark_safe(verdict))


class _PlatformSettingsPriceMixin:
    """⚠ عمداً **بیرون و بالای** دکوراتور. اگر بینِ @admin.register و کلاسِ
    ادمین بنشیند، دکوراتور همین میکسین را می‌گیرد و جنگو می‌گوید
    «Wrapped class must subclass ModelAdmin»."""

    @admin.display(description='سنجش با تعرفه')
    def price_cross_check(self, obj):
        return _price_cross_check(obj)


