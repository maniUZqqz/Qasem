class BrandStampMixin:
    """مهرِ لوگو و نامِ چغر روی فایلِ تصویریِ تازه‌آپلودشده.

    خواستِ مالک: «وقتی آموزشِ حرکت آپلود می‌کنم، خودش لوگو و اسم را مثلِ بقیه
    روی تصویر بیندازد.»

    ⚠ فقط روی فیلدی که در همین فرم **عوض شده** اعمال می‌شود. اگر روی هر ذخیره
    اجرا می‌شد، هر بار یک مهرِ تازه روی مهرِ قبلی می‌نشست.
    """
    stamp_fields = ()

    def _stamp_changed_files(self, request, obj, form):
        from .branding import stamp_field
        changed = set(getattr(form, 'changed_data', []) or [])
        done = []
        for name in self.stamp_fields:
            if name not in changed:
                continue
            field = getattr(obj, name, None)
            if field and stamp_field(field):
                done.append(name)
        if done:
            obj.save(update_fields=done)
            self.message_user(request, 'لوگو و نامِ چغر روی %s گذاشته شد.' % '، '.join(done))

    def save_model(self, request, obj, form, change):
        super().save_model(request, obj, form, change)
        self._stamp_changed_files(request, obj, form)


@admin.register(ExerciseLibrary)
class ExerciseLibraryAdmin(BrandStampMixin, admin.ModelAdmin):
    """کتابخانهٔ حرکت‌ها — فقط نمایش و ویرایشِ متن؛ ورودِ داده با API انجام می‌شود."""
