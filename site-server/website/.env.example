# آدرسِ بک‌اند جنگو برای «سرورِ» Next (قیمت پلن‌ها، وبلاگ، نسخه، /api/*). فقط سمتِ سرور خوانده می‌شود.
INTERNAL_API_BASE=http://127.0.0.1:8000

# آدرسِ API برای «مرورگرِ» بازدیدکننده (فرمِ تماس، آمار). خالی = همان دامنه (/api/v1/...)، که درست است.
# ⚠ هرگز آدرسِ لوپ‌بک (127.0.0.1 / localhost) اینجا نگذارید: داخلِ جاوااسکریپتِ بازدیدکننده می‌رود و
# فرمِ تماس به کامپیوترِ خودِ او می‌فرستد (همهٔ پیام‌ها گم می‌شد). npm run build در این حالت شکست می‌خورد.
NEXT_PUBLIC_API_BASE=

# آدرس پنل محصول — دکمه‌های «ورود» و «شروع رایگان» به اینجا می‌روند
NEXT_PUBLIC_PANEL_URL=http://127.0.0.1:5173

# دامنه‌ی سایت — برای sitemap، robots و متادیتای SEO
NEXT_PUBLIC_SITE_URL=https://nmarketing.ir

# کلیدی که جنگو با آن می‌گوید «این صفحه عوض شد، دوباره بخوانش».
# دست نزنید: start.bat خودش می‌سازدش و در .env.production.local می‌نویسد
# (نه اینجا و نه در .env.local — این دو کامیت می‌شوند).
# اگر خالی بماند، ویرایش‌های جنگو ادمین تا ۲ دقیقه بعد روی سایت می‌نشینند.
REVALIDATE_SECRET=
