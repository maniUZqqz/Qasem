<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- سرویسِ HTTPِ صدای فارسی + صفحهٔ آزمایش. اجرا: Run-Server.bat -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- فقط فایل‌های بومیِ ویندوزِ ۶۴بیتی -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>PersianAiKit.Server</RootNamespace>
    <AssemblyName>PersianAiKit.Voice.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PersianAiKit.Voice\PersianAiKit.Voice.csproj" />
  </ItemGroup>

</Project>
