{% extends 'app/panel/_shell.html' %}
{% comment %}
اسکنِ زندهٔ دستگاه‌ها (مورد ۶).

دوربین روشن می‌ماند، کاربر در باشگاه می‌چرخد و هر چند ثانیه یک فریم بررسی
می‌شود؛ هر چه پیدا شود همان لحظه به فهرست اضافه می‌شود. در پایان تأیید می‌گیرد.

دو حالت، خودش تصمیم می‌گیرد:
  · **زنده** روی HTTPS (الان دامنه HTTPS است، پس روی گوشی کار می‌کند)
  · **عکسی** اگر مرورگر اجازهٔ دوربینِ زنده نداد — همان مسیرِ فریم را می‌زند
{% endcomment %}
{% block title %}اسکنِ دستگاه | چغر{% endblock %}

{% block panel %}
<div class="pnl-card">
  <h3>۱) اسکنِ زندهٔ باشگاه</h3>
  <p class="muted">دوربین را روشن کن و آرام در باشگاه بچرخ. هر دستگاهی که دیده
    شود همان لحظه پایین اضافه می‌شود. تا تأیید نکنی، چیزی ثبت نمی‌شود.</p>

  <div style="margin-bottom:10px">
    <label>نامِ باشگاه (اختیاری)</label>
    <input type="text" id="gym" placeholder="مثلاً باشگاهِ پارس">
  </div>

  <div id="modeNote" class="muted" style="margin-bottom:10px">در حالِ آماده‌سازی…</div>

  <div id="stage" style="position:relative;background:#0d1117;border-radius:14px;
       overflow:hidden;aspect-ratio:3/4;max-width:420px;display:flex;
       align-items:center;justify-content:center">
    <video id="cam" playsinline muted autoplay style="width:100%;height:100%;
           object-fit:cover;display:none"></video>
    <img id="shot" alt="" style="width:100%;height:100%;object-fit:cover;display:none">
    <div id="hint" style="color:#c9d1d9;font-size:14px;text-align:center;padding:18px">
      برای شروع، دکمهٔ زیر را بزن.
    </div>
    <div id="live" style="position:absolute;top:10px;inset-inline-start:10px;display:none;
         background:#d32f2f;color:#fff;border-radius:999px;padding:4px 10px;font-size:12px">
      ● زنده
    </div>
    <div id="toast" style="position:absolute;inset-inline:0;bottom:0;background:rgba(0,0,0,.6);
         color:#ffd400;font-size:14px;font-weight:700;text-align:center;padding:9px;display:none"></div>
  </div>

  <div class="row" style="margin-top:12px">
    <button type="button" class="primary" id="btnStart">شروعِ اسکن</button>
    <button type="button" id="btnSwap" disabled>دوربینِ جلو / عقب</button>
    <button type="button" id="btnSnap" style="display:none">گرفتنِ عکس</button>
    <button type="button" id="btnStop" disabled>پایانِ اسکن</button>
    <input type="file" accept="image/*" capture="environment" id="snapFile" hidden>
  </div>
  <div id="stat" class="muted" style="margin-top:8px"></div>
</div>

<div class="pnl-card" id="out" style="display:none">
  <h3>۲) تأییدِ دستگاه‌ها</h3>
  <p class="muted">تیکِ چیزهایی که درست تشخیص داده شده را نگه دار. عکسِ کنارِ هر
    نام، عکسِ مرجعِ همان دستگاه در کتابخانهٔ ماست.</p>
  <div id="items"></div>
  <div style="margin-top:12px">
    <button type="button" class="primary" onclick="confirmItems()">تأیید و افزودن</button>
    <span id="msg2" class="muted"></span>
  </div>
</div>

<div class="pnl-card" id="done" style="display:none">
  <h3>نتیجه</h3>
  <div id="doneText"></div>
</div>
{% endblock %}

{% block panel_js %}
<script>
let scanId = null, stream = null, timer = null, busy = false;
let facing = 'environment', framesLeft = 0, interval = 2500;
const items = new Map();

const video = document.getElementById('cam');
const shot = document.getElementById('shot');
const hint = document.getElementById('hint');
const toast = document.getElementById('toast');
const stat = document.getElementById('stat');
const live = document.getElementById('live');
const note = document.getElementById('modeNote');

const canLive = !!(window.isSecureContext && navigator.mediaDevices
                   && navigator.mediaDevices.getUserMedia);
note.innerHTML = canLive
  ? 'حالتِ <b>زنده</b>: دوربین روشن می‌ماند و خودش تشخیص می‌دهد.'
  : 'مرورگر اجازهٔ دوربینِ زنده نداد (برای حالتِ زنده، سایت باید با <b>https</b> باز شود). '
    + 'حالتِ <b>عکسی</b> فعال است: با هر عکس یک تشخیص.';

function say(text) {
  toast.style.display = '';
  toast.textContent = text;
  clearTimeout(say._t);
  say._t = setTimeout(() => { toast.style.display = 'none'; }, 3500);
}

async function startCamera() {
  stream = await navigator.mediaDevices.getUserMedia({
    video: { facingMode: facing, width: { ideal: 1280 } }, audio: false,
  });
  video.srcObject = stream;
  video.style.display = 'block';
  hint.style.display = 'none';
  live.style.display = '';
  await video.play().catch(() => {});
}

function stopCamera() {
  if (stream) { stream.getTracks().forEach(t => t.stop()); stream = null; }
  video.style.display = 'none';
  live.style.display = 'none';
}

async function grabBlob() {
  const c = document.createElement('canvas');
  c.width = video.videoWidth || 1280;
  c.height = video.videoHeight || 960;
  c.getContext('2d').drawImage(video, 0, 0, c.width, c.height);
  return new Promise(res => c.toBlob(res, 'image/jpeg', 0.85));
}

async function sendFrame(blob) {
  if (!scanId || busy) return;
  busy = true;
  const fd = new FormData();
  fd.append('frame', blob, 'frame.jpg');
  try {
    const res = await fetch(API + 'equipment-scan/' + scanId + '/frame/',
                            { method: 'POST', headers: H, body: fd });
    const data = await res.json().catch(() => null);
    if (res.status === 429) { say(data.message); renderItems(data.items); stop(); return; }
    if (!res.ok) { say((data && (data.error || data.detail)) || 'خطا'); return; }
    framesLeft = data.frames_left;
    stat.textContent = 'فریم‌های بررسی‌شده: ' + data.frames_used
                     + ' | باقی‌مانده: ' + data.frames_left
                     + ' | پیدا شده: ' + data.items.length;
    if (data.new_items.length) {
      say('پیدا شد: ' + data.new_items.map(i => i.name).join('، '));
    }
    renderItems(data.items);
    if (data.frames_left <= 0) stop();
  } finally { busy = false; }
}

function renderItems(list) {
  const box = document.getElementById('items');
  list.forEach(it => items.set(it.id, it));
  if (!items.size) return;
  document.getElementById('out').style.display = '';
  box.innerHTML = '';
  [...items.values()].forEach(it => {
    const cb = el('input', { type: 'checkbox', 'data-id': it.id });
    if (!it.already_exists && it.confidence >= 0.5) cb.checked = true;
    const img = it.catalog_image
      ? el('img', { src: it.catalog_image, style: 'width:44px;height:44px;object-fit:cover;border-radius:8px' })
      : el('span', { class: 'chip' }, ['—']);
    const tags = [el('span', { class: 'chip' }, ['اطمینان ' + Math.round(it.confidence * 100) + '٪'])];
    if (it.already_exists) tags.push(el('span', { class: 'chip' }, ['از قبل بود']));
    if (!it.in_library) tags.push(el('span', { class: 'chip' }, ['نامِ تازه']));
    if (it.muscle_group) tags.push(el('span', { class: 'chip' }, [it.muscle_group]));
    box.append(el('div', { class: 'ex-row' },
      [cb, img, el('span', { class: 'nm' }, [it.name]), el('span', {}, tags)]));
  });
}

async function start() {
  const btn = document.getElementById('btnStart');
  btn.disabled = true;
  const { ok, data } = await api('equipment-scan/start/', {
    json: { gym_name: document.getElementById('gym').value.trim() },
  });
  if (!ok) { btn.disabled = false; say((data && data.error) || 'شروع نشد'); return; }
  scanId = data.scan_id;
  framesLeft = data.max_frames;
  interval = data.frame_interval_ms || 2500;
  stat.textContent = 'سقفِ این دور: ' + data.max_frames + ' فریم'
                   + (data.charged_tokens ? ' · ' + data.charged_tokens + ' توکن کم شد' : ' · رایگان');
  document.getElementById('btnStop').disabled = false;

  if (canLive) {
    try { await startCamera(); } catch (e) {
      say('دوربین باز نشد: ' + e.message);
      document.getElementById('btnStart').disabled = false;
      return;
    }
    document.getElementById('btnSwap').disabled = false;
    timer = setInterval(async () => {
      const b = await grabBlob();
      if (b) sendFrame(b);
    }, interval);
  } else {
    document.getElementById('btnSnap').style.display = '';
    hint.textContent = 'دکمهٔ «گرفتنِ عکس» را بزن.';
  }
}

function stop() {
  if (timer) { clearInterval(timer); timer = null; }
  stopCamera();
  document.getElementById('btnSwap').disabled = true;
  document.getElementById('btnStop').disabled = true;
  document.getElementById('btnStart').disabled = false;
  document.getElementById('btnSnap').style.display = 'none';
  if (items.size) say('اسکن تمام شد — پایین تأیید کن.');
}

async function confirmItems() {
  const accept = [...document.querySelectorAll('#items input[type=checkbox]')]
    .filter(c => c.checked).map(c => Number(c.dataset.id));
  const msg2 = document.getElementById('msg2');
  msg2.textContent = 'در حالِ ثبت…';
  const { ok, data } = await api('equipment-scan/' + scanId + '/confirm/', { json: { accept } });
  if (!ok) { msg2.textContent = (data && data.error) || 'خطا'; return; }
  msg2.textContent = '';
  document.getElementById('out').style.display = 'none';
  const box = document.getElementById('doneText');
  box.innerHTML = '';
  box.append(el('p', {}, [data.message]));
  (data.added || []).forEach(x => box.append(el('div', { class: 'chip' }, [x.name])));
  document.getElementById('done').style.display = '';
  items.clear();
  scanId = null;
}

document.getElementById('btnStart').addEventListener('click', start);
document.getElementById('btnStop').addEventListener('click', stop);
document.getElementById('btnSwap').addEventListener('click', async () => {
  facing = facing === 'environment' ? 'user' : 'environment';
  stopCamera();
  try { await startCamera(); } catch (e) { say('دوربین عوض نشد: ' + e.message); }
});
document.getElementById('btnSnap').addEventListener('click',
  () => document.getElementById('snapFile').click());
document.getElementById('snapFile').addEventListener('change', async e => {
  const f = e.target.files[0];
  if (!f) return;
  shot.src = URL.createObjectURL(f);
  shot.style.display = 'block';
  hint.style.display = 'none';
  say('در حالِ بررسی…');
  await sendFrame(f);
  e.target.value = '';
});
window.addEventListener('pagehide', () => { if (timer) clearInterval(timer); stopCamera(); });
</script>
{% endblock %}
