16:T44c,{"@context":"https://schema.org","@type":"HowTo","name":"چطور با NMarketing محتوای تبلیغاتی بسازیم","description":"از ثبت فروشگاه تا انتشار خودکار در اینستاگرام.","step":[{"@type":"HowToStep","position":1,"name":"Add your shop and products","text":"Brand name, tone of voice, shipping and returns policy, and products with real photos."},{"@type":"HowToStep","position":2,"name":"Product and competitor analysis","text":"Your product photos get read, and competitor prices come off the open web."},{"@type":"HowToStep","position":3,"name":"Posters and images","text":"Built on your real product photo, with the text laid over it."},{"@type":"HowToStep","position":4,"name":"Promotional video","text":"Script, scene breakdown, and one continuous video with narration."},{"@type":"HowToStep","position":5,"name":"Captions and sales copy","text":"For Instagram, Telegram and LinkedIn — each in its own register."},{"@type":"HowToStep","position":6,"name":"Approve and publish","text":"Whatever you approve goes straight to Instagram."}]}5:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$16"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Do I need to know how to use AI?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. You enter the product and its photo; the rest is automatic. There is no prompt writing.\"}},{\"@type\":\"Question\",\"name\":\"Does it use my product photo, or an invented image?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Your real photo. The poster is built on top of it, so the buyer sees exactly what they are buying.\"}},{\"@type\":\"Question\",\"name\":\"How does it tell customers price and stock?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Only from what you entered. It never invents a number, and if it does not know something it says so.\"}},{