# ---- Django core ----
DJANGO_SECRET_KEY=change-me-on-the-main-system
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=*
TIME_ZONE=UTC
LOG_LEVEL=INFO
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ---- Limits / security (production: set DJANGO_DEBUG=false + a long random SECRET_KEY) ----
MAX_UPLOAD_MB=10
THROTTLE_ANON=30/minute
THROTTLE_USER=240/minute
# Behind HTTPS also set:
# SECURE_SSL_REDIRECT=true
# SESSION_COOKIE_SECURE=true
# CSRF_COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000

# ---- Database: Django's built-in SQLite (no setup needed) ----
# Optional custom file location:
# SQLITE_PATH=C:\upmarket-data\db.sqlite3

# ---- Celery / Redis ----
REDIS_URL=redis://127.0.0.1:6379/0
# auto (recommended) = look at the machine on startup:
#   Redis reachable  -> real queue, Celery workers, VIDEO GENERATION WORKS
#   Redis missing    -> run AI jobs inside the request (no Redis needed)
# You never have to edit this by hand. Force a mode with true / false.
# No Redis installed? run install-redis.bat once (downloads a portable Redis).
CELERY_TASK_ALWAYS_EAGER=auto

# ---- Ollama (main system: the machine where the models are installed) ----
# 127.0.0.1, not localhost: on Windows `localhost` tries IPv6 first and
# waits ~2s per call before falling back to IPv4 (Ollama binds IPv4 only).
# ---- AI mode: local models, or an API? --------------------------------
# Leave AI_API_BASE_URL empty  -> text/vision run on the local Ollama box.
# Set it to an OpenAI-compatible endpoint -> this machine needs NO GPU,
# and start.bat will not launch Ollama or ComfyUI at all.
#
# Iranian providers verified 2026-09-10 (all price in USD, not toman):
#   Metis   https://api.metisai.ir/openai/v1   official model price + 10%
#   AvalAI  https://api.avalai.ir/v1           official price, no markup
#   Liara   see liara.ir/pricing               monthly plan + token passthrough
#
# Admin rows in ModelProvider still override this — it only replaces the
# built-in default.
AI_API_BASE_URL=
AI_API_KEY=
AI_API_MODEL_TEXT=gpt-4o-mini
AI_API_MODEL_VISION=gpt-4o-mini
AI_API_TIMEOUT=180

# ---- which engine runs what ------------------------------------------------
# Asked once by the launcher (`python manage.py aisetup`) and written here.
# Each capability is separate: whatever goes to an API, its local engine is
# never started.
#
#   AI_MODE_TEXT   local -> Ollama          api -> AI_API_BASE_URL below
#   AI_MODE_IMAGE  local -> ComfyUI (FLUX)  api -> MEDIA_API_* below
#   AI_MODE_VIDEO  local -> ComfyUI (Wan)   api -> MEDIA_API_* below
#
# Vision rides with text: same Ollama, same choice.
# "api" without the matching credentials falls back to local, so the launcher
# never skips an engine the product still needs.
AI_MODE_TEXT=local
AI_MODE_IMAGE=local
AI_MODE_VIDEO=local

# Image/video over an API (Replicate-style prediction endpoint).
MEDIA_API_BASE_URL=https://api.replicate.com/v1/predictions
MEDIA_API_TOKEN=
MEDIA_API_MODEL_IMAGE=
MEDIA_API_MODEL_VIDEO=
MEDIA_API_TIMEOUT=900

# ---- data policy ----------------------------------------------------------
# What a store gets before its owner chooses (apps.ai.StoreAIPolicy lets each
# store override this, and the panel shows them what it means).
#
#   HYBRID             any active provider may answer  (default; what every
#                      install did before the policy layer existed)
#   APPROVED_EXTERNAL  only providers ticked "approved" in the admin
#   LOCAL_ONLY         nothing leaves this server. A job with no local model
#                      FAILS with a clear message instead of quietly calling
#                      an API. Narration uses the OFFLINE Piper voice
#                      (python manage.py audio_setup downloads it); the
#                      online voices are never reached.
#
# Set LOCAL_ONLY if you promise every customer that their data stays here.
AI_DEFAULT_POLICY=HYBRID

# ---- email (بازیابی رمز) --------------------------------------------------
# The ONLY thing email is used for: letting someone who forgot their password
# back in. Leave EMAIL_HOST empty and the reset message is printed to the
# server log instead of being sent — fine for development, and the settings
# refuse to start in production without it, because a silently discarded
# reset email means the customer waits for a link that never arrives.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=no-reply@nmarketing.ir
# How long a reset link stays usable, in seconds. 86400 = one day.
PASSWORD_RESET_TIMEOUT=86400
THROTTLE_PASSWORD_RESET=5/hour

OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_BASE_URL=http://192.168.10.80:11434

# Preferred model per task. Only models that are ACTUALLY pulled on the
# machine are used: at run time the app reads `ollama list` (GET /api/tags)
# and skips anything that is not installed.
OLLAMA_MODEL_REASONING=qwq:32b
OLLAMA_MODEL_VISION=qwen3-vl:30b
OLLAMA_MODEL_CODER=qwen3-coder:30b

# Tried in order when the preferred model is missing OR fails (out of VRAM,
# timeout, non-JSON). Leave empty to use vision+coder as the fallbacks.
# On a 12 GB card qwq:32b is a dense 18.5 GB model and only ~29/65 layers fit,
# so a run can be very slow: if market analysis is still slow, simply put
# OLLAMA_MODEL_REASONING=qwen3-vl:30b here-> it is a Mixture-of-Experts model
# (3B active) and runs several times faster on the same card.
# OLLAMA_MODEL_FALLBACKS=qwen3-vl:30b,qwen3-coder:30b
OLLAMA_MODEL_FALLBACK=true
# at most this many models per call (2 = one fallback). Keeps the worst
# case at ~2 timeouts instead of walking the whole model list.
OLLAMA_MODEL_MAX_ATTEMPTS=2

# 32B models load from disk first (1-3 min on this hardware) and THEN think.
# A timeout is never retried (that only multiplies the wait) - the next model
# in the fallback list is tried instead.
OLLAMA_TIMEOUT=600
OLLAMA_RETRIES=2
# Auto-allocate GPU layers (Ollama fits as much as possible in 12GB)
OLLAMA_NUM_GPU=-1
# How long a model stays in VRAM after a call. Short, so the next model (or
# ComfyUI) is not starved on a single card.
OLLAMA_KEEP_ALIVE=5m
# Context window per request. Smaller = less KV cache = more room for weights.
OLLAMA_NUM_CTX=8192
# Token budget for JSON answers. Every extra token is CPU seconds when a model
# is only partly offloaded.
OLLAMA_NUM_PREDICT_JSON=4096

# ---- ComfyUI ----
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=900
COMFYUI_POLL_INTERVAL=2.0

# ---- Generation ----
VIDEO_SEGMENT_DURATION=5
GPU_CONCURRENCY_LIMIT=1
# single-GPU coordination: before ComfyUI work the Ollama models are unloaded,
# and before heavy Ollama work ComfyUI VRAM is freed AND every other Ollama
# model is evicted (best-effort, safe)
GPU_AUTO_UNLOAD=true

# ---- Dead-job cleanup ----
# A job whose worker died would otherwise show an endless spinner. These are
# the ages after which a job is declared dead (seconds). Defaults are derived
# from the timeouts above; only set them to override.
# JOB_RUNNING_STALE_SECONDS=2400
# JOB_QUEUED_STALE_SECONDS=300
# JOB_GPU_QUEUED_STALE_SECONDS=2700

# ---- Voice, ambience/effects and noise removal ----
# WHICH engine is used is chosen in the admin: /admin/ai/audioengine/
# (Audio engines) - tick active, set priority, press the test action to hear it.
# Offline engines (Piper voice, DeepFilterNet, the sound library) are
# downloaded once with:   python manage.py audio_setup
# Mix levels (voice, ambience, effects, the shop's background): /admin/ai/audiomix/
#
# The lines below only matter on a fresh install whose engine table is empty.
# edge = Microsoft neural voices (Persian supported; needs internet)
TTS_PROVIDER=edge
# AUDIO_MODELS_DIR=D:/upmarket-models      # default: Code/UpMarket/models
# DEEPFILTER_BIN=C:/tools/deep-filter.exe
# voice per narration language (chosen in the video studio UI):
TTS_VOICE_FA=fa-IR-FaridNeural
TTS_VOICE_EN=en-US-ChristopherNeural
# gTTS fallback does NOT support Persian:
# TTS_PROVIDER=gtts
# TTS_LANGUAGE=en

# ---- Semantic product search (vector embeddings) ----
# OFF by default - no embedding model is installed yet. To enable on the main
# system:  ollama pull nomic-embed-text   then set:
EMBEDDINGS_ENABLED=false
OLLAMA_MODEL_EMBEDDING=nomic-embed-text

# ---- Web research (competitor sites beyond Digikala/Torob) ----
# searxng = self-hosted metasearch (recommended - your own instance, never blocked)
#   docker run -d -p 8888:8080 searxng/searxng
#   then in its settings.yml under `search:` add `formats: [html, json]`
# brave   = official Brave Search API (free key from brave.com/search/api)
WEB_SEARCH_PROVIDER=none
# SEARXNG_BASE_URL=http://127.0.0.1:8888
# BRAVE_API_KEY=

# ---- Publishing (n8n) ----
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/upmarket-publish
# N8N_WEBHOOK_TOKEN=change-me
PUBLIC_BASE_URL=http://localhost:8000

# ---- Payments -----------------------------------------------------------
# With none of these set, the only offered method is a bank transfer that a
# human confirms in the admin — which is what the business does today.
#
# ZarinPal: paste the merchant id from your panel (a 36-character UUID).
# Amounts are converted to Rial by the provider; everything inside this
# project stays in Toman.
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# Where the customer transfers money when paying by bank.
MANUAL_ACCOUNT_INFO=

# Pre-selected gateway. Empty = pick the first configured one.
PAYMENT_DEFAULT_PROVIDER=

BILLING_PERIOD_DAYS=30
# Days a lapsed subscription keeps working after its period ends, so an
# expired card does not immediately cut off a paying customer.
BILLING_GRACE_DAYS=3

# Public base URL the gateway redirects back to, and where to land the user.
PAYMENT_CALLBACK_BASE=http://127.0.0.1:8000
PANEL_URL=http://127.0.0.1:5173

# ---- سایت عمومی --------------------------------------------------------
# آدرس سایت Next.js. وقتی چیزی در جنگو ادمین ذخیره می‌شود، جنگو به همین
# آدرس خبر می‌دهد تا صفحه‌ی مربوطه را دوباره بسازد؛ بدون آن، ویرایش تا
# ۲ دقیقه بعد روی سایت نمی‌نشیند و به‌نظر می‌رسد ادمین اصلاً وصل نیست.
WEBSITE_URL=http://127.0.0.1:3001
# کلید مشترک با سایت. خالی بگذارید — start.bat خودش می‌سازد و در
# backend/.env.local می‌نویسد (این فایل کامیت نمی‌شود).
WEBSITE_REVALIDATE_SECRET=

# ---------------------------------------------------------------- media storage
# local (default) keeps files on a volume. That is correct for one machine and
# wrong the moment there are two — a volume is not shared, and a rendered video
# the shop is about to publish would be on exactly one box.
#
# s3 speaks the S3 protocol, which ArvanCloud, Liara and a self-hosted MinIO all
# support. With MEDIA_STORAGE=s3 the server refuses to start unless the bucket
# and credentials are filled in, rather than quietly writing to the container.
MEDIA_STORAGE=local
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
# private by default — a bucket of customer photos and unreleased campaign
# videos is not a public directory
S3_ACL=private
S3_SIGNED_URLS=true
