5:[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"HowTo\",\"name\":\"چطور با NMarketing محتوای تبلیغاتی بسازیم\",\"description\":\"از ثبت فروشگاه تا انتشار خودکار در اینستاگرام.\",\"step\":[{\"@type\":\"HowToStep\",\"position\":1,\"name\":\"فروشگاه و محصول را ثبت کنید\",\"text\":\"نام برند، لحن، سیاست‌های ارسال و مرجوعی، و محصولات با عکس واقعی.\"},{\"@type\":\"HowToStep\",\"position\":2,\"name\":\"تحلیل محصول و رقبا\",\"text\":\"عکس محصول خوانده می‌شود و قیمت رقبا از وب درمی‌آید.\"},{\"@type\":\"HowToStep\",\"position\":3,\"name\":\"پوستر و تصاویر\",\"text\":\"از عکس واقعی محصول شما، با متن فارسی روی تصویر.\"},{\"@type\":\"HowToStep\",\"position\":4,\"name\":\"ویدیوی تبلیغاتی\",\"text\":\"سناریو، صحنه‌بندی، و ویدیوی پیوسته با صداگذاری فارسی.\"},{\"@type\":\"HowToStep\",\"position\":5,\"name\":\"کپشن و متن فروش\",\"text\":\"برای اینستاگرام، تلگرام و لینکدین — هرکدام با لحن خودش.\"},{\"@type\":\"HowToStep\",\"position\":6,\"name\":\"تأیید و انتشار\",\"text\":\"هرچه پسندیدید مستقیم در اینستاگرام منتشر می‌شود.\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"باید بلد باشم با هوش مصنوعی کار کنم؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"نه. اطلاعات محصول و عکسش را وارد می‌کنید؛ بقیه‌اش خودکار است. پرامپت‌نویسی لازم نیست.\"}},{\"@type\":\"Question\",\"name\":\"عکس محصول خودم استفاده می‌شود یا تصویر ساختگی؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"عکس واقعی خودتان. پوستر از روی همان عکس ساخته می‌شود تا مشتری دقیقاً همان چیزی را ببیند که می‌خرد.\"}},{\"@type\":\"Question\",\"name\":\"قیمت و موجودی را چطور به مشتری می‌گوید؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"فقط از روی اطلاعاتی که خودتان ثبت کرده‌اید. سیستم عدد نمی‌سازد و اگر چیزی را نداند می‌گوید نمی‌داند.\"}},{\"@type\":\"Question\",\"name\":\"محتوا به چه زبانی است؟\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"فارسی، با لحن برند خودتان. نریشن ویدیو هم فارسی یا انگلیسی، به انتخاب شما.\"}}]}"}}]],["$","section",null,{"className":"mesh","children":[["$","$L16",null,{}],["$","div",null,{"className":"wrap hero-grid","children":[["$","div",null,{"className":"reveal","children":[["$","span",null,{"className":"eyebrow","children":"دو هفته رایگان، بدون کارت بانکی"}],["$","h1",null,{"className":"mt","children":["بازاریابی فروشگاه شما،"," ",["$","span",null,{"className":"gradient-text","children":"خودکار"}]]}],["$","p",null,{"className":"lead mt","children":["اطلاعات محصولت را بده — پوستر، ویدیو، کپشن و پشتیبانی فروشش را تحویل بگیر."," بدون گرافیست، بدون تدوینگر، بدون کپی‌رایتر."]}],["$","div",null,{"className":"row mt-md","children":[["$","a",null,{"href":"http://87.107.160.17:8040/panel/register","className":"btn btn-primary","children":"شروع رایگان"}],["$","$L13",null,{"href":"/showcase","className":"btn btn-ghost","children":"نمونه‌کارهای بیشتر"}]]}],["$","div",null,{"className":"pill-row mt-md","style":{"justifyContent":"flex-start"},"children":[["$","span",null,{"className":"pill","children":"🎨 پوستر"}],["$","span",null,{"className":"pill","children":"🎬 ویدیو"}],["$","span",null,{"className":"pill","children":"✍️ کپشن"}],["$","span",null,{"className":"pill","children":"🤝 پشتیبان فروش"}]]}]]}],["$","div",null,{"className":"hero-art reveal reveal-1 tilt","children":[["$","img",null,{"src":"/showcase/apparel.png","alt":"پوستر تولیدشده برای کت اورسایز کرم","width":1024,"height":1024,"fetchPriority":"high"}],["$","div",null,{"className":"hero-float hero-float-1","children":[["$","span",null,{"children":"🎨"}]," از عکس واقعی محصول"]}],["$","div",null,{"className":"hero-float hero-float-2","children":[["$","span",null,{"children":"🖼️"}]," ","از عکس واقعی محصول"]}]]}]]}]]}],["$","div",null,{"className":"band","children":["$","div",null,{"className":"wrap band-grid","children":[["$","div","نوع خروجی",{"class