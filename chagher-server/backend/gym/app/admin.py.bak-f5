        ('اطلاعات پزشکی', {
            'fields': ('injuries', 'food_allergies', 'body_issues', 'chronic_diseases', 'extra_notes')
        }),
        ('تنظیمات برنامه', {
            'fields': ('program_type', 'program_days', 'training_place'),
            'description': 'نوع برنامه هزینه توکن را تعیین می‌کند: ورزشی و غذایی ۵۰ توکن، فقط ورزشی یا فقط غذایی ۲۵ توکن (ویرایش هم ۲۵ توکن).'
        }),
        ('🏋️ برنامه ورزشی', {
            'fields': ('generated_workout_display',),
            'classes': ('collapse',)
        }),
        ('🍽️ برنامه غذایی', {
            'fields': ('generated_meal_plan_display',),
            'classes': ('collapse',)
        }),
        ('📊 آمار پلتفرم', {
            'fields': ('tokens_consumed',)
        }),
        ('💰 هزینه واقعی هوش مصنوعی', {
            'fields': ('ai_model_name', 'ai_input_tokens', 'ai_output_tokens', 'ai_cost'),
            'description': 'توکن واقعی مصرف‌شده روی مدل و هزینه آن بر اساس تعرفه ثبت‌شده '
                           'در «تنظیمات API» در لحظه تولید. این اعداد فقط خواندنی‌اند.'
        }),
        ('تاریخ‌ها', {
            'fields': ('created_at', 'updated_at')
        }),
    )

    @admin.display(boolean=True, description='برنامه ورزشی')
    def has_workout(self, obj):
        return bool(obj.generated_workout)

    @admin.display(boolean=True, description='برنامه غذایی')
    def has_meal_plan(self, obj):
        return bool(obj.generated_meal_plan)

    @admin.display(description='برنامه ورزشی تولید شده')
    def generated_workout_display(self, obj):
        if obj.generated_workout:
            html = markdown.markdown(
                obj.generated_workout,
                extensions=['extra', 'fenced_code', 'tables', 'nl2br', 'sane_lists']
            )
            return mark_safe(
                '<div style="direction: rtl; text-align: right; font-family: Tahoma, sans-serif; background: #f8f9fa; '
                'padding: 15px; border-radius: 8px; max-height: 500px; overflow-y: auto; line-height:1.9;">'
                f'{html}'
                '</div>'
            )
        return '❌ هنوز تولید نشده'

    @admin.display(description='برنامه غذایی تولید شده')
    def generated_meal_plan_display(self, obj):
        if obj.generated_meal_plan:
            html = markdown.markdown(
                obj.generated_meal_plan,
                extensions=['extra', 'fenced_code', 'tables', 'nl2br', 'sane_lists']
            )
            return mark_safe(
                '<div style="direction: rtl; text-align: right; font-family: Tahoma, sans-serif; background: #f0fff4; '
                'padding: 15px; border-radius: 8px; max-height: 500px; overflow-y: auto; line-height:1.9;">'
                f'{html}'
                '</div>'
            )
        return '❌ هنوز تولید نشده'


@admin.register(APIConfig)
class APIConfigAdmin(admin.ModelAdmin):
    """زنجیره‌ی ارائه‌دهنده‌های هوش مصنوعی.

    ترتیب فهرست همان ترتیب واقعی امتحان‌کردن است: اولویت ۱ اول، و اگر پاسخ
    نداد، اولویت بعدی.
    """
    list_display = [
        'priority', 'name', 'type_badge', 'effective_model', 'endpoint_display',
        'price_summary', 'listener_status', 'health_display', 'is_active',
    ]
    list_display_links = ['name']
    list_editable = ['priority', 'is_active']
    list_filter = ['is_active', 'provider_type']
    search_fields = ['name', 'base_url', 'model_name']
    ordering = ['priority', 'id']
    list_per_page = 20
    actions = [
        'activate_selected', 'deactivate_selected',
        'test_connection', 'discover_models',
    ]

    @admin.display(description='نوع', ordering='provider_type')
    def type_badge(self, obj):
        # ⚠ پیش از این فقط دو حالت را می‌شناخت و «شنونده» را «ابری» نشان می‌داد
        if obj.provider_type == obj.PROVIDER_TYPE_LISTENER:
            return '📡 شنونده'
        if obj.is_local:
            return '🖥 محلی'
        return '☁ ابری'

    @admin.display(description='مدل')
    def effective_model(self, obj):
        explicit = (obj.model_name or '').strip()
        if explicit:
            return explicit
        if obj.discovered_model:
            return format_html(
                '<span title="خودکار از سرور خوانده شد">{} <small>(خودکار)</small></span>',
                obj.discovered_model,
            )
        if obj.is_local:
            return format_html('<small style="color:#6b7280;">هنگام اولین استفاده خوانده می‌شود</small>')
        return format_html('<span style="color:#b91c1c;">— وارد نشده</span>')

    @admin.display(description='آدرس')
    def endpoint_display(self, obj):
        url = obj.base_url or '-'
        return url if len(url) <= 44 else f'{url[:44]}…'

    @admin.display(description='تعرفه (ورودی / خروجی به ازای ۱M توکن)')
    def price_summary(self, obj):
        if not obj.input_price_per_million and not obj.output_price_per_million:
            return '— رایگان/ثبت نشده' if obj.is_local else '— ثبت نشده'
        return (
            f"{_toman(obj.input_price_per_million)} / "
            f"{_toman(obj.output_price_per_million)} تومان"
        )

    @admin.display(description='وضعیت آخرین اتصال')
    def health_display(self, obj):
        if obj.last_error and (
            not obj.last_success_at
            or (obj.last_failure_at and obj.last_failure_at > obj.last_success_at)
        ):
            return format_html(
                '<span style="color:#b91c1c;">✗ {}</span>',
                obj.last_error[:60],
            )
        if obj.last_success_at:
            return format_html(
                '<span style="color:#15803d;">✓ {}</span>',
                obj.last_success_at.strftime('%Y-%m-%d %H:%M'),
            )
        return '— هنوز استفاده نشده'

    # ═════════════════ سرورِ شنونده (حالتِ سوم) ═════════════════
    # ⚠ ایرادی که مالک گزارش کرد: ادمین هیچ‌جا نمی‌گفت کارگر باید به کدام
    #   آدرس وصل شود و کلیدش چیست — پس عملاً نمی‌شد شنونده را تنظیم کرد.
    #   این بخش همان را، با وضعیتِ زنده و اسکریپتِ آماده، نشان می‌دهد.

    @staticmethod
    def _bridge_base():
        from django.conf import settings
        base = (getattr(settings, 'PUBLIC_BASE_URL', '') or '').rstrip('/')
        return (base or 'https://chagher.ir') + '/api/ai-bridge'

    @admin.display(description='شنونده')
    def listener_status(self, obj):
        if obj.provider_type != obj.PROVIDER_TYPE_LISTENER:
            return '—'
        if not (obj.api_key or '').strip():
            return format_html('<span style="color:#b91c1c;">کلید خالی</span>')
        if obj.listener_is_online():
            return format_html(
                '<span style="color:#15803d;font-weight:700;">● روشن</span>'
                '<br><small style="color:#6b7280;">{}</small>',
                obj.listener_worker_name or 'کارگر',
            )
        if obj.listener_last_seen_at:
            return format_html(
                '<span style="color:#b45309;">خاموش</span>'
                '<br><small style="color:#6b7280;">آخرین بار: {}</small>',
                timezone.localtime(obj.listener_last_seen_at).strftime('%Y-%m-%d %H:%M'),
            )
        return format_html('<span style="color:#6b7280;">هنوز وصل نشده</span>')

    @admin.display(description='راهنمای راه‌اندازیِ شنونده')
    def listener_setup(self, obj):
        from django.utils.html import escape
        from django.utils.safestring import mark_safe
        from .models import AIJob

        base = self._bridge_base()
        key = (obj.api_key or '').strip()

        if key:
            key_html = (
                '<code style="background:#eef2ff;padding:3px 8px;border-radius:6px;'
                'user-select:all;">%s</code>' % escape(key)
            )
        else:
            key_html = (
                '<b style="color:#b91c1c;">خالی است — تا پرش نکنید هیچ کارگری '
                'نمی‌تواند وصل شود.</b> یک رشتهٔ تصادفیِ بلند در «کلید API» بالا '
                'بنویسید و ذخیره کنید؛ همان می‌شود رمزِ کارگر.'
            )

        # وضعیتِ زنده
        if not obj.is_active:
            state = ('<span style="color:#b91c1c;font-weight:700;">این ردیف فعال نیست</span>'
                     ' — تا تیکِ «فعال» بالا را نزنید، کارگر خطای ۴۰۳ می‌گیرد.')
        elif not key:
            state = '<span style="color:#b91c1c;">کلید تنظیم نشده</span>'
        elif obj.listener_is_online():
            state = ('<span style="color:#15803d;font-weight:700;">● روشن است</span> '
                     '(کارگر: %s)' % escape(obj.listener_worker_name or 'نامشخص'))
        elif obj.listener_last_seen_at:
            state = ('<span style="color:#b45309;">خاموش است</span> — آخرین بار %s'
                     % escape(timezone.localtime(obj.listener_last_seen_at)
                              .strftime('%Y-%m-%d %H:%M')))
        else:
            state = '<span style="color:#6b7280;">تا حالا هیچ کارگری وصل نشده</span>'

        try:
            queued = AIJob.objects.filter(provider_id=obj.id,
                                          status=AIJob.STATUS_QUEUED).count()
            running = AIJob.objects.filter(provider_id=obj.id,
                                           status=AIJob.STATUS_LEASED).count()
            jobs = 'در صف: %d · در حالِ اجرا: %d' % (queued, running)
        except Exception:
            jobs = ''

        window = obj.listener_online_window or 90

        script = """import time, requests

BASE = "{base}"
KEY  = "{key}"              # همان کلیدی که در جنگو ادمین گذاشتید
H    = {{"X-Worker-Key": KEY}}

def ask_model(messages, max_tokens):
    \"\"\"این تابع را به مدلِ خودتان وصل کنید (Ollama، LM Studio، vLLM …).\"\"\"
    r = requests.post("http://127.0.0.1:11434/v1/chat/completions",
                      json={{"model": "llama3",
                            "messages": messages,
                            "max_tokens": max_tokens or 2048}},
                      timeout=600)
    r.raise_for_status()
    d = r.json()
    return d["choices"][0]["message"]["content"], d.get("usage", {{}})

while True:
    try:
        r = requests.post(BASE + "/claim/", headers=H,
                          json={{"worker": "pc-1"}}, timeout=30)
        if r.status_code == 204:      # فعلاً کاری نیست
            time.sleep(3)
            continue
        r.raise_for_status()
        job = r.json()
        try:
            text, usage = ask_model(job["messages"], job.get("max_tokens"))
            requests.post(BASE + "/%s/result/" % job["job_id"], headers=H,
                          json={{"text": text, "usage": usage}}, timeout=60)
        except Exception as e:
            requests.post(BASE + "/%s/fail/" % job["job_id"], headers=H,
                          json={{"error": str(e)[:400]}}, timeout=30)
    except Exception:
        time.sleep(5)             # اینترنت قطع بود؛ بعداً دوباره
""".format(base=base, key=key or 'کلید-را-این‌جا-بگذارید')

        html = """
<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;
            padding:16px;line-height:2;max-width:860px">

  <p style="margin:0 0 12px">
    این حالت برای سرورِ هوش مصنوعیِ خودتان است که <b>آی‌پیِ ثابت ندارد</b>.
    سایت هیچ‌وقت به آن وصل نمی‌شود؛ برعکس، خودِ آن سرور هر چند ثانیه به
    آدرس‌های زیر سر می‌زند و می‌پرسد «کاری هست؟».
  </p>

  <p style="margin:0 0 6px"><b>۱) کلیدِ کارگر</b></p>
  <p style="margin:0 0 14px">{key_html}</p>

  <p style="margin:0 0 6px"><b>۲) آدرس‌هایی که کارگر صدا می‌زند</b>
     <small style="color:#6b7280">(هدرِ <code>X-Worker-Key</code> در همه لازم است)</small></p>
  <table style="border-collapse:collapse;margin:0 0 14px;font-size:13px">
    <tr><td style="padding:3px 10px 3px 0">گرفتنِ کار</td>
        <td><code style="user-select:all">POST {base}/claim/</code></td></tr>
    <tr><td style="padding:3px 10px 3px 0">تحویلِ جواب</td>
        <td><code style="user-select:all">POST {base}/&lt;job_id&gt;/result/</code></td></tr>
    <tr><td style="padding:3px 10px 3px 0">اعلامِ شکست</td>
        <td><code style="user-select:all">POST {base}/&lt;job_id&gt;/fail/</code></td></tr>
    <tr><td style="padding:3px 10px 3px 0">ضربانِ زنده</td>
        <td><code style="user-select:all">POST {base}/heartbeat/</code></td></tr>
  </table>

  <p style="margin:0 0 6px"><b>۳) وضعیتِ همین حالا</b></p>
  <p style="margin:0 0 14px">{state}{jobs_html}</p>

  <p style="margin:0 0 6px"><b>۴) اسکریپتِ آماده</b>
     <small style="color:#6b7280">— روی سرورِ خودتان اجرا کنید
     (<code>pip install requests</code>)</small></p>
  <pre style="background:#0f172a;color:#e2e8f0;padding:14px;border-radius:8px;
              overflow:auto;direction:ltr;text-align:left;font-size:12px;
              line-height:1.7;max-height:380px">{script}</pre>

  <p style="margin:12px 0 0;color:#475569;font-size:12.5px">
    <b>نکته‌ها:</b>
    هر بار که کارگر «گرفتنِ کار» را صدا بزند، همان لحظه «روشن» حساب می‌شود؛
    پس اگر هر {window} ثانیه یک‌بار سر بزند کافی است و نیازی به ضربانِ جدا نیست.
    اگر کارگر خاموش باشد، سایت <b>اصلاً کاری نمی‌سازد</b> و مستقیم سراغِ
    ارائه‌دهندهٔ بعدیِ زنجیره می‌رود — کاربر معطل نمی‌ماند.
    جوابی که دیرتر از مهلت برسد <b>پذیرفته نمی‌شود</b>، تا یک درخواست دو بار
    هزینه نشود.
  </p>
</div>
""".format(
            key_html=key_html,
            base=escape(base),
            state=state,
            jobs_html=(' · <small style="color:#6b7280">%s</small>' % escape(jobs)) if jobs else '',
            script=escape(script),
            window=window,
        )
        return mark_safe(html)

    def get_readonly_fields(self, request, obj=None):
        # این فیلدها را خود سامانه پر می‌کند (کشف مدل، پارامترهای قابل‌قبول،
        # نتیجه‌ی آخرین اتصال)؛ ویرایش دستی‌شان فقط وضعیت واقعی را خراب می‌کند.
        base = ['discovered_model', 'discovered_at',
                'token_param', 'supports_temperature',
                'last_success_at', 'last_failure_at', 'last_error',
                'listener_setup', 'listener_last_seen_at', 'listener_worker_name']
        if obj:
            return base + ['created_at', 'updated_at']
        return base

    def get_fieldsets(self, request, obj=None):
        base_fieldsets = [
            ('جایگاه در زنجیره', {
                'fields': ('name', 'priority', 'is_active'),
                'description': 'اولویت ۱ اول از همه امتحان می‌شود. اگر آن ارائه‌دهنده '
                               'در دسترس نباشد (سرور خاموش، اینترنت قطع، اعتبار تمام‌شده)، '
                               'سامانه خودکار سراغ اولویت بعدی می‌رود و کاربر خطایی نمی‌بیند.'
            }),
            ('نوع و اتصال', {
                'fields': ('provider_type', 'base_url', 'api_key', 'model_name',
                           'timeout_seconds'),
                'description': (
                    '<b>🖥 مدل محلی / سرور خودم:</b> فقط لینک سرور را بگذارید — '
                    'مثل <code>http://192.168.1.50:11434</code>. '
                    'کلید API و نام مدل لازم نیست: مسیر <code>/v1</code> خودکار '
                    'اضافه می‌شود و نام مدل از خود سرور خوانده می‌شود. '
                    '(اگر چند مدل روی سرور دارید و یکی خاص را می‌خواهید، فقط آن '
                    'وقت نامش را در «نام مدل» بنویسید.)<br><br>'
                    '<b>☁ سرویس ابری:</b> آدرس کامل مثل '
                    '<code>https://api.openai.com/v1</code> یا '
                    '<code>https://api.metisai.ir/openai/v1</code>؛ کلید API و '
                    'نام مدل هر دو الزامی‌اند.<br><br>'
                    '<b>📡 سرورِ خودم بدونِ آی‌پی (شنونده):</b> «آدرس سرور» را '
                    'خالی بگذارید. فقط یک رشتهٔ تصادفیِ بلند در «کلید API» بنویسید '
                    'و ذخیره کنید؛ بعد از ذخیره، بخشِ «📡 سرورِ شنونده» پایینِ همین '
                    'صفحه باز می‌شود و آدرس‌ها و اسکریپتِ آماده را به شما می‌دهد.'
                    '<br><br>'
                    '<b>مهلت پاسخ:</b> مدل محلی روی سخت‌افزار ضعیف کند است؛ '
                    'عدد بزرگ‌تری بگذارید (مثلاً ۳۰۰).'
                )
            }),
            ('تعرفه توکن این مدل', {
                'fields': ('input_price_per_million', 'output_price_per_million'),
                'description': 'قیمتی که سرویس‌دهنده برای همین مدل اعلام کرده، بر حسب '
                               'تومان به ازای یک میلیون توکن. با همین عدد هزینه واقعی هر '
                               'برنامه محاسبه می‌شود. برای مدل محلی معمولاً صفر می‌ماند.'
            }),
        ]
        if obj and obj.provider_type == obj.PROVIDER_TYPE_LISTENER:
            base_fieldsets.append(
                ('📡 سرورِ شنونده — راه‌اندازی و وضعیت', {
                    'fields': ('listener_setup', 'listener_online_window',
                               'listener_last_seen_at', 'listener_worker_name'),
                    'description': 'برای این نوع، «آدرس سرور» و «نام مدل» لازم نیست؛ '
                                   'فقط «کلید API» را پر کنید — همان کلیدِ کارگر است.'
                })
            )
        if obj:
            base_fieldsets.append(
                ('سلامت اتصال (فقط گزارشی)', {
                    'fields': ('discovered_model', 'discovered_at',
                               'token_param', 'supports_temperature',
                               'last_success_at', 'last_failure_at', 'last_error'),
                    'description': 'آخرین نتیجه‌ی واقعی استفاده از این ارائه‌دهنده. '
                                   '«مدل کشف‌شده» نامی است که خودکار از سرور خوانده شد و '
                                   '«پارامتر سقف توکن» نامی است که این مدل می‌پذیرد '
                                   '(مدل‌های استدلالی به‌جای max_tokens فقط '
                                   'max_completion_tokens را قبول می‌کنند). هر دو خودکار '
                                   'کشف می‌شوند و با تغییر آدرس یا نام مدل پاک می‌شوند.'
                })
            )
            base_fieldsets.append(
                ('تاریخ‌ها', {'fields': ('created_at', 'updated_at')})
            )
        return base_fieldsets

    @admin.action(description='فعال‌کردن در زنجیره')
    def activate_selected(self, request, queryset):
        updated = queryset.update(is_active=True)
        self.message_user(request, f'{updated} ارائه‌دهنده فعال شد.')

    @admin.action(description='غیرفعال‌کردن')
    def deactivate_selected(self, request, queryset):
        updated = queryset.update(is_active=False)
        self.message_user(request, f'{updated} ارائه‌دهنده غیرفعال شد.')

    @admin.action(description='🔌 تست اتصال ارائه‌دهنده‌های انتخاب‌شده')
    def test_connection(self, request, queryset):
        """یک درخواست کوچک واقعی می‌فرستد تا پیش از استقرار معلوم شود
        آدرس، کلید و نام مدل درست‌اند — نه اینکه اولین کاربر متوجه شود."""
        from ai_engine.ai_generator import ping_model

        ok, failed = [], []
        for provider in queryset:
            try:
                # دقیقاً همان مسیری که هنگام تولید برنامه طی می‌شود: کشف
                # خودکار نام مدل و سازگارکردن پارامترها. نتیجه ذخیره می‌شود،
                # پس اولین کاربر واقعی دیگر هزینه‌ی کشف را نمی‌دهد.
                model = ping_model(provider)
                provider.mark_success()
                ok.append(f'{provider.name} → {model}')
            except Exception as exc:
                provider.mark_failure(exc)
                failed.append(f'{provider.name} ({type(exc).__name__}: {exc})')

        if ok:
            self.message_user(request, f"✓ متصل شد: {'، '.join(ok)}")
        if failed:
            self.message_user(
                request, f"✗ ناموفق: {'، '.join(failed)}", level=messages.ERROR
            )

    @admin.action(description='🔍 خواندن فهرست مدل‌های سرور')
    def discover_models(self, request, queryset):
        """نشان می‌دهد روی هر سرور چه مدل‌هایی نصب است.

        برای وقتی که چند مدل روی سرور دارید و می‌خواهید بدانید نام دقیقشان
        چیست تا یکی را صریح انتخاب کنید.
        """
        from ai_engine.ai_generator import build_client

        for provider in queryset:
            try:
                client = build_client(provider.as_config())
                models_found = provider.available_models(client)
            except Exception as exc:
                provider.mark_failure(exc)
                self.message_user(
                    request,
                    f'{provider.name}: خطا در خواندن فهرست مدل‌ها ({exc})',
                    level=messages.ERROR,
                )
                continue

            if not models_found:
                self.message_user(
                    request,
                    f'{provider.name}: سرور هیچ مدلی معرفی نکرد.',
                    level=messages.WARNING,
                )
                continue

            self.message_user(
                request,
                f"{provider.name} → {'، '.join(models_found)}"
                + ('' if provider.model_name else f' (خودکار: {models_found[0]})'),
            )


@admin.register(TokenPackage)
class TokenPackageAdmin(admin.ModelAdmin):
    """مدیریت بسته‌های توکن"""
    list_display = ['name', 'token_amount', 'price_per_50_tokens', 'package_price_display', 'is_active', 'created_at']
    list_filter = ['is_active', 'created_at']
    search_fields = ['name']
    readonly_fields = ['created_at', 'updated_at']
    list_editable = ['price_per_50_tokens', 'is_active']
    actions = ['activate_selected', 'deactivate_selected']

    fieldsets = (
        ('تعرفه', {
            'fields': ('name', 'token_amount', 'price_per_50_tokens', 'is_active'),
            'description': 'تعداد توکن باید مضربی از 50 باشد. صفحه خرید توکن از همین تعرفه‌ها برای محاسبه قیمت استفاده می‌کند.'
        }),
        ('تاریخ‌ها', {
            'fields': ('created_at', 'updated_at')
        }),
    )

    @admin.display(description='قیمت این بسته (تومان)')
    def package_price_display(self, obj):
        return obj.calculate_price()

    def save_model(self, request, obj, form, change):
        if obj.token_amount % 50 != 0:
            from django.core.exceptions import ValidationError
            raise ValidationError('تعداد توکن باید مضربی از 50 باشد.')
        super().save_model(request, obj, form, change)

    @admin.action(description='فعال‌کردن تعرفه‌های انتخاب‌شده')
    def activate_selected(self, request, queryset):
        updated = queryset.update(is_active=True)
        self.message_user(request, f'{updated} تعرفه فعال شد.')

    @admin.action(description='غیرفعال‌کردن تعرفه‌های انتخاب‌شده')
    def deactivate_selected(self, request, queryset):
        updated = queryset.update(is_active=False)
        self.message_user(request, f'{updated} تعرفه غیرفعال شد.')


