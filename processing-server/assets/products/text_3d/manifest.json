{
  "id": "text_3d",
  "version": 1,
  "name": {
    "fa": "متنِ سه‌بعدی (فارسی و لاتین)",
    "en": "3D text"
  },
  "description": {
    "fa": "هر نوشته‌ای را با فونتِ وزیرمتن (حروفِ فارسیِ چسبیده و راست‌به‌چپ) به حروفِ برجستهٔ سه‌بعدی با پخ و جنسِ دلخواه تبدیل می‌کند",
    "en": "Turns any text into bevelled 3D letters with the Vazirmatn font (correct Persian shaping, right to left) and a finish of your choice."
  },
  "builder": "text3d",
  "min_engine": "1.3.0",
  "order": 21,
  "ai": false,
  "tags": [
    "text",
    "logo"
  ],
  "dimensions": [
    0.5,
    0.05,
    0.15
  ],
  "grasp": {
    "height": 0.5,
    "radius": 0.035,
    "curl": 0.8,
    "preset": "grip",
    "azimuth": 35,
    "tilt": 8,
    "gap": 0.006
  },
  "params": {
    "text": {
      "type": "text",
      "default": "نمونه",
      "label": "نوشته (برای خطِ تازه | بگذارید)"
    },
    "weight": {
      "type": "enum",
      "values": [
        "Black",
        "Bold",
        "Medium",
        "Regular"
      ],
      "default": "Black",
      "label": "ضخامتِ حروف"
    },
    "width_m": {
      "type": "number",
      "default": 0.5,
      "min": 0.02,
      "max": 6.0,
      "label": "پهنای کلِ نوشته (متر)"
    },
    "depth_m": {
      "type": "number",
      "default": 0.05,
      "min": 0.002,
      "max": 0.5,
      "label": "ضخامت (متر)"
    },
    "bevel_m": {
      "type": "number",
      "default": 0.004,
      "min": 0.0,
      "max": 0.05,
      "label": "پخِ لبه (متر)"
    },
    "line_gap": {
      "type": "number",
      "default": 1.2,
      "min": 0.9,
      "max": 2.0,
      "label": "فاصلهٔ خطوط"
    },
    "finish": {
      "type": "enum",
      "values": [
        "gold",
        "rose_gold",
        "copper",
        "chrome",
        "brushed_steel",
        "brushed_aluminium",
        "titanium",
        "black_gloss",
        "white_gloss",
        "matte",
        "soft_touch",
        "glass",
        "frosted_glass",
        "carbon",
        "neon"
      ],
      "default": "gold",
      "label": "جنس"
    },
    "use_color": {
      "type": "bool",
      "default": false,
      "label": "رنگِ دلخواه به‌جای رنگِ جنس"
    },
    "color": {
      "type": "color",
      "default": "#d9a73a",
      "label": "رنگ"
    },
    "glow": {
      "type": "number",
      "default": 6.0,
      "min": 0.5,
      "max": 40.0,
      "label": "شدتِ نورِ نئون"
    }
  },
  "license": "UpMarket 3D (procedural, own) + font: Vazirmatn (OFL)"
}
