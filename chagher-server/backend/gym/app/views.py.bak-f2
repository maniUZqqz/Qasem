            return Response({'error': 'خطا در تولید PDF. لطفاً دوباره تلاش کنید.'},
                            status=status.HTTP_500_INTERNAL_SERVER_ERROR)

        response = HttpResponse(content, content_type='application/pdf')
        response['Content-Disposition'] = f'attachment; filename="meal_{client.name}_{client.id}.pdf"'
        return response





# ==================== Template-Based Views (صفحات معرفی) ====================

from django.shortcuts import render, get_object_or_404, redirect
from django.contrib import messages
from .models import HomePage, Feature, BlogPost, TeamMember, ContactMessage


def home_page(request):
    """صفحهٔ خانه — روی میزبانِ ورزشکار، لندینگِ خودش را نشان می‌دهد.

    دو لندینگِ جدا خواستهٔ صریحِ مالک است: پیامِ باشگاه‌دار و پیامِ ورزشکار یکی
    نیست و قاطی‌کردنشان هر دو را ضعیف می‌کند.
    """
    # روی میزبانِ **پنلِ** ورزشکار، ریشه مستقیم می‌رود به پنلِ خودش؛ لندینگ
    # جای دیگری است (قرینهٔ panel.chagher.ir که اپ را می‌دهد، نه لندینگ).
    if getattr(request, 'is_b2c_panel', False):
        # ریشهٔ میزبانِ پنل (my): کاربرِ واردشده می‌رود به حسابش، ولی مهمان
        # نباید با یک فرمِ لختِ ورود روبه‌رو شود — می‌رود به هوم‌پیجِ ورزشکار.
        if request.user.is_authenticated:
            return redirect('panel-me')
        landing = getattr(request, 'b2c_host', '') or 'app.chagher.ir'
        return redirect('https://%s/' % landing)

    if getattr(request, 'is_b2c', False):
        from .models import PlatformSettings
        settings_obj = PlatformSettings.get_solo()
        # اعدادِ صفحه از دیتابیس می‌آیند، نه دست‌نویس — وگرنه روزی که کتابخانه
        # بزرگ‌تر شود، لندینگ دروغ می‌گوید.
        from .models import ExerciseLibrary, EquipmentCatalog
        return render(request, 'app/b2c_home.html', {
            'ai_free_programs': _fa_num(settings_obj.ai_free_programs),
            'exercise_count': _fa_num(
                ExerciseLibrary.objects.filter(is_public=True).count()
                or ExerciseLibrary.objects.count()),
            'equipment_count': _fa_num(EquipmentCatalog.objects.count()),
            # محتوای واقعی به‌جای کارتِ خالی: نوارِ حرکت‌ها و عکسِ دستگاه‌ها.
            # نام‌های کوتاه انتخاب می‌شوند تا زیرِ تصویر نشکنند.
            'strip_exercises': list(
                ExerciseLibrary.objects
                .exclude(thumb='').exclude(thumb__isnull=True)
                .exclude(name_fa='')
                .order_by('external_id')[:60]
            )[:14],
            'equipment_samples': _equipment_cards(EquipmentCatalog),
            'app_host': getattr(request, 'b2c_host', ''),
            'panel_host': getattr(request, 'b2c_panel_host', ''),
            'b2b_host': getattr(request, 'b2b_host', 'chagher.ir'),
        })
    return _home_page_b2b(request)


def _fa_num(value):
    """عدد را با ارقامِ فارسی و جداکنندهٔ هزارگانِ فارسی برمی‌گرداند.

    چرا لازم شد: در لندینگِ B2C شماره‌های گام فارسی بودند ولی اعدادِ آمار
    لاتین درمی‌آمدند و چشم را می‌زد.
    """
    try:
        text = '{:,}'.format(int(value)).replace(',', '٬')
    except (TypeError, ValueError):
        return value
    return text.translate(str.maketrans('0123456789', '۰۱۲۳۴۵۶۷۸۹'))

def _equipment_cards(model, limit=6):
    """عکسِ دستگاه‌ها برای لندینگ — با نسخهٔ کوچکِ ۴۰۰پیکسلی اگر ساخته شده باشد.

    اصل‌ها ۵۳ تا ۱۹۳ کیلوبایت‌اند ولی روی صفحه حدود ۱۷۰ پیکسل دیده می‌شوند؛
    فرستادنِ اصل به موبایلِ کاربر اسراف است. اگر فایلِ کوچک نبود، خودِ اصل
    داده می‌شود تا صفحه هرگز عکسِ شکسته نشان ندهد.
    """
    import os
    from django.conf import settings
    cards = []
    qs = model.objects.exclude(image='').exclude(image__isnull=True)[:limit]
    for item in qs:
        url = item.image.url
        base = os.path.basename(item.image.name)
        small_rel = os.path.join('equipment_catalog', 'sm', os.path.splitext(base)[0] + '.jpg')
        if os.path.exists(os.path.join(settings.MEDIA_ROOT, small_rel)):
            url = settings.MEDIA_URL + small_rel.replace(os.sep, '/')
        cards.append({'url': url, 'name': getattr(item, 'name_fa', '') or item.name})
    return cards

def _home_page_b2b(request):
    """صفحه اصلی سایت"""
    homepage = HomePage.objects.filter(is_active=True).first()
    features = Feature.objects.filter(is_active=True).order_by('order')[:6]

    context = {
        'homepage': homepage,
        'features': features,
    }
    return render(request, 'app/home.html', context)


def blog_list(request):
    """لیست وبلاگ"""
    posts = BlogPost.objects.filter(is_published=True).order_by('-created_at')

    context = {
        'posts': posts,
    }
    return render(request, 'app/blog.html', context)


def blog_detail(request, slug):
    """جزئیات پست وبلاگ"""
    post = get_object_or_404(BlogPost, slug=slug, is_published=True)

    context = {
        'post': post,
    }
    return render(request, 'app/blog_detail.html', context)


def contact_page(request):
    """صفحه تماس با ما"""
    if request.method == 'POST':
        name = request.POST.get('name')
        email = request.POST.get('email')
        phone = request.POST.get('phone', '')
        subject = request.POST.get('subject')
        message = request.POST.get('message')

        # ذخیره پیام در دیتابیس
        ContactMessage.objects.create(
            name=name,
            email=email,
            phone=phone,
            subject=subject,
            message=message
        )

        messages.success(request, 'پیام شما با موفقیت ارسال شد. به زودی با شما تماس خواهیم گرفت.')
        # الگوی Post/Redirect/Get — رفرش صفحه باعث ارسال دوباره فرم نمی‌شود
        return redirect('contact')

    return render(request, 'app/contact.html')


def about_page(request):
    """صفحه درباره ما"""
    team_members = TeamMember.objects.all().order_by('order')

    context = {
        'team_members': team_members,
    }
    return render(request, 'app/about.html', context)


def features_page(request):
    """صفحه امکانات"""
    features = Feature.objects.filter(is_active=True).order_by('order')

    context = {
        'features': features,
    }
    return render(request, 'app/features.html', context)


# ==================== صفحه‌های آموزشِ حرکت (کتابخانهٔ چغر) ====================
def exercise_detail_page(request, external_id):
    """صفحهٔ آموزشِ یک حرکت — همین آدرس در PDF لینک می‌شود."""
    from django.shortcuts import get_object_or_404
    from .models import ExerciseLibrary
    ex = get_object_or_404(ExerciseLibrary, external_id=external_id, is_active=True)
    related = (ExerciseLibrary.objects
               .filter(is_active=True, target=ex.target)
               .exclude(pk=ex.pk)[:8])
    # دکمهٔ «بررسیِ درستیِ حرکت» فقط وقتی ساخته می‌شود که مدیر روشنش کرده باشد
    from .models import PlatformSettings
    return render(request, 'app/exercise_detail.html', {
        'ex': ex, 'related': related,
        'form_check_enabled': PlatformSettings.get_solo().form_check_enabled,
    })


def exercise_list_page(request):
    """کتابخانهٔ حرکت‌ها با جست‌وجو و فیلترِ دستگاه."""
    from django.core.paginator import Paginator
    from django.db.models import Q
    from .models import ExerciseLibrary
    qs = ExerciseLibrary.objects.filter(is_active=True)
    q = (request.GET.get('q') or '').strip()
    equipment = (request.GET.get('equipment') or '').strip()
    if q:
        qs = qs.filter(Q(name_fa__icontains=q) | Q(name__icontains=q) | Q(target_fa__icontains=q))
    if equipment:
        qs = qs.filter(equipment_fa=equipment)
    equipments = (ExerciseLibrary.objects.filter(is_active=True)
                  .exclude(equipment_fa='').values_list('equipment_fa', flat=True).distinct().order_by('equipment_fa'))
    paginator = Paginator(qs.order_by('name_fa'), 24)
    page_obj = paginator.get_page(request.GET.get('page'))
    return render(request, 'app/exercise_list.html', {
        'page_obj': page_obj, 'q': q, 'equipment': equipment,
        'equipments': list(equipments), 'total': qs.count(),
    })
