<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- سرویسِ HTTPِ ویرایشگرِ عکس + «فوتوشاپِ وب» (wwwroot). اجرا: Run-Server.bat ⇒ http://localhost:5670 -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <!-- فقط فایل‌های بومیِ ویندوزِ ۶۴بیتی -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <RootNamespace>PersianAiKit.Photo.Server</RootNamespace>
    <AssemblyName>PersianAiKit.Photo.Server</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PersianAiKit.Photo\PersianAiKit.Photo.csproj" />
  </ItemGroup>

</Project>
