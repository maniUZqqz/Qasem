def _toman(value):
    """نمایش مبلغ به تومان با جداکننده هزارگان."""
    try:
        return f"{Decimal(value or 0):,.0f}"
    except Exception:
        return '0'


class ReadOnlyAdminMixin:
    """پنل کاملاً فقط خواندنی.

    برای بخش‌های حسابداری لازم است: هیچ‌کس — حتی سوپریوزر — نباید بتواند از
    پنل ادمین یک عدد مالی را دستی جابه‌جا کند، وگرنه گزارش ورودی/خروجی دیگر
    قابل استناد نیست.
    """

    def has_add_permission(self, request):
        return False

    def has_change_permission(self, request, obj=None):
        return False

    def has_delete_permission(self, request, obj=None):
        return False

    def get_actions(self, request):
        actions = super().get_actions(request)
        actions.pop('delete_selected', None)
        return actions


@admin.register(CustomUser)
class CustomUserAdmin(UserAdmin):
    """مدیریت کاربران در پنل ادمین"""
    list_display = ['phone_number', 'account_type', 'gym_name', 'token_balance', 'is_staff', 'date_joined']
    list_filter = ['account_type', 'is_staff', 'is_superuser', 'is_active']
    search_fields = ['phone_number', 'gym_name']
    ordering = ['-date_joined']

    fieldsets = (
        ('اطلاعات اصلی', {
            'fields': ('phone_number', 'password', 'account_type'),
            'description': 'نوع حساب مرز دسترسی را تعیین می‌کند: مربی به مدیریت باشگاه، '
                           'ورزشکار باشگاه به پروفایل مشتری، و کاربر شخصی فقط به برنامه‌های خودش.'
        }),
        ('اطلاعات باشگاه', {
            'fields': ('gym_name', 'token_balance'),
            'description': 'اگر کاربر «برند باشگاه» داشته باشد، مرجع موجودی همان کیف پول برند است؛ '
                           'تغییر این عدد به‌طور خودکار کیف پول برند را هم به‌روز می‌کند.'
        }),
        ('دسترسی‌ها', {
            'fields': ('is_active', 'is_staff', 'is_superuser', 'groups', 'user_permissions')
        }),
        ('تاریخ‌ها', {
            'fields': ('last_login', 'date_joined')
        }),
    )

    add_fieldsets = (
        ('ایجاد کاربر جدید', {
            'classes': ('wide',),
            'fields': ('phone_number', 'password1', 'password2', 'account_type', 'gym_name', 'token_balance'),
        }),
    )

    readonly_fields = ['date_joined', 'last_login']

    def get_readonly_fields(self, request, obj=None):
        """فقط در ویرایش، تاریخ‌ها read-only باشند"""
        if obj:
            return self.readonly_fields
        return []

    def save_model(self, request, obj, form, change):
        """اگر ادمین موجودی را عمداً تغییر داد، کیف پول برند (مرجع) را هم به‌روز کن.
        بدون این، ذخیره کامل مدل، مقدار را دوباره از کیف پول برند می‌خواند و تغییر ادمین بی‌اثر می‌شد.

        هر تغییر دستی موجودی یک سطر در دفتر حساب ثبت می‌کند تا صورت‌حساب
        کاربر با واقعیت بخواند و هیچ شارژ دستی بی‌ردپا نماند."""
        previous = None
        if change and 'token_balance' in form.changed_data:
            previous = CustomUser.objects.filter(pk=obj.pk).values_list(
                'token_balance', flat=True
            ).first()
            GymBrand.objects.filter(user=obj).update(
                token_balance=obj.token_balance, updated_at=timezone.now()
            )

        super().save_model(request, obj, form, change)

        if previous is not None and previous != obj.token_balance:
            delta = obj.token_balance - previous
            actor = getattr(getattr(request, 'user', None), 'phone_number', 'system')
            LedgerEntry.record(
                LedgerEntry.TYPE_TOKEN_GRANT if delta > 0 else LedgerEntry.TYPE_TOKEN_SPEND,
                user=obj,
                tokens=delta,
                reference=f'admin:{actor}',
                description=(
                    f'تغییر دستی موجودی از {previous:,} به {obj.token_balance:,} '
                    f'توسط {actor}'
                ),
            )


