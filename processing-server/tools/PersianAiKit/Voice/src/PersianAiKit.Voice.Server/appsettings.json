{
  "Kit": {
    // پوشهٔ مدل‌ها؛ خالی ⇒ پوشهٔ models را خودش از کنارِ برنامه رو به بالا پیدا می‌کند
    "ModelsDir": "",
    // کشِ صدا، صداهای کلون‌شده و گواهیِ https؛ خالی ⇒ پوشهٔ data کنارِ models
    "DataDir": "",
    "HttpPort": 5600,
    // https برای میکروفونِ گوشی لازم است (مرورگر روی http فقط در localhost اجازه می‌دهد). 0 ⇒ خاموش
    "HttpsPort": 5601,
    // false ⇒ فقط همین کامپیوتر (localhost). true ⇒ همهٔ شبکه — آن‌وقت حتماً ApiKey بگذارید
    "LanAccess": false,
    // خالی ⇒ بی‌کلید. پر ⇒ هر درخواستِ /api باید سرآیندِ X-Api-Key (یا ?key=) داشته باشد
    "ApiKey": "",
    "Tts": {
      "Voice": "fa_IR-gyro-medium",
      "Speed": 1.0,
      "MaxConcurrent": 2
    },
    "Asr": {
      "MaxConcurrent": 2,
      "MaxSeconds": 300
    },
    // سرویسِ پایتونیِ صدا (گفتارِ طبیعی، کلون، صدای هر چیز) — نصب: Setup-Voice.bat؛ راهنما: VOICE-SETUP.md
    "Voice": {
      "Url": "http://127.0.0.1:5620",
      "AutoStart": true,
      "AsrCheck": true
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
