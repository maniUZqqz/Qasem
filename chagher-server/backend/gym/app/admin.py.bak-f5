@admin.register(ProgramShareCode)
class ProgramShareCodeAdmin(admin.ModelAdmin):
    """کدهای یکبارمصرف دانلود برنامه.

    فقط برای رصد است: کد را مربی از پنل خودش می‌سازد و مصرفش هم از سمت
    ورزشکار اتفاق می‌افتد. ساخت یا «مصرف‌نشده کردن» دستی از اینجا مجاز
    نیست، وگرنه قاعده‌ی یک‌بارمصرف بودن بی‌معنا می‌شود.
    """
    list_display = [
        'code', 'program_link', 'coach', 'section', 'state_display',
        'expires_at', 'created_at',
    ]
    list_filter = ['is_used', 'section', 'created_at']
    search_fields = [
        'code', 'program__name', 'created_by__phone_number', 'created_by__gym_name',
    ]
    autocomplete_fields = ['program', 'created_by']
    readonly_fields = [
        'code', 'program', 'created_by', 'section', 'expires_at',
        'is_used', 'used_at', 'created_at',
    ]
    list_per_page = 30

    def has_add_permission(self, request):
        return False

    def has_change_permission(self, request, obj=None):
        return False

    @admin.display(description='برنامه')
    def program_link(self, obj):
        return f'#{obj.program_id} — {obj.program.name}'

    @admin.display(description='مربی')
    def coach(self, obj):
        return obj.created_by.gym_name or obj.created_by.phone_number

    @admin.display(description='وضعیت')
    def state_display(self, obj):
        if obj.is_used:
            when = obj.used_at.strftime('%Y-%m-%d %H:%M') if obj.used_at else ''
            return format_html('<span style="color:#6b7280;">✓ مصرف‌شده {}</span>', when)
        if obj.is_expired:
            return format_html('<span style="color:#b91c1c;">✗ منقضی</span>')
        return format_html('<span style="color:#15803d;">آماده استفاده</span>')


