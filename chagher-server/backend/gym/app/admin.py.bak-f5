@admin.register(TokenPurchase)
class TokenPurchaseAdmin(admin.ModelAdmin):
    """مدیریت خریدهای توکن — شامل تایید رسیدهای کارت‌به‌کارت"""
    list_display = [
        'user', 'payment_method', 'token_amount', 'final_price_display', 'status',
        'receipt_link', 'receipt_reference', 'discount_code', 'reviewed_by', 'created_at'
    ]
    list_filter = ['status', 'payment_method', 'created_at']
    search_fields = ['user__phone_number', 'payment_ref_id', 'receipt_reference']
    autocomplete_fields = ['user', 'discount_code']
    # receipt_image عمداً فقط‌خواندنی است: فایل در فضای خصوصی بدون base_url
    # ذخیره می‌شود، پس ویجت آپلود جنگو که برای لینک دادن .url را صدا می‌زند
    # صفحه را می‌شکند. نمایش رسید از receipt_preview و مسیر محافظت‌شده انجام
    # می‌شود؛ رسید را هم فقط خود کاربر باید بارگذاری کند، نه مدیر.
    readonly_fields = [
        'created_at', 'updated_at', 'receipt_image_display', 'receipt_preview',
        'receipt_uploaded_at', 'reviewed_by', 'reviewed_at',
    ]
    actions = [
        'approve_card_receipts', 'reject_card_receipts',
        'mark_as_paid_and_charge_tokens', 'charge_missing_tokens',
        'mark_as_failed', 'mark_as_cancelled',
    ]

    fieldsets = (
        ('اطلاعات خرید', {
            'fields': ('user', 'token_amount', 'status', 'payment_method',
                       'payment_authority', 'payment_ref_id')
        }),
        ('مالی', {
            'fields': ('original_price', 'discount_code', 'discount_amount', 'final_price')
        }),
        ('رسید کارت‌به‌کارت', {
            'fields': ('card_account', 'receipt_image_display', 'receipt_preview',
                       'receipt_reference', 'receipt_note', 'receipt_uploaded_at'),
            'description': 'برای آزاد کردن توکن یا سفارش را از فهرست انتخاب کنید و اکشن '
                           '«تایید رسید کارت‌به‌کارت» را بزنید، یا همین‌جا وضعیت را روی '
                           '«پرداخت شده» بگذارید و ذخیره کنید — هر دو مسیر توکن را شارژ '
                           'می‌کنند و در دفتر حساب ثبت می‌شوند.'
        }),
        ('بررسی', {
            'fields': ('reviewed_by', 'reviewed_at', 'review_note')
        }),
        ('تاریخ‌ها', {
            'fields': ('created_at', 'updated_at')
        }),
    )

    @admin.display(description='مبلغ نهایی', ordering='final_price')
    def final_price_display(self, obj):
        return f"{_toman(obj.final_price)} تومان"

    @admin.display(description='فایل رسید')
    def receipt_image_display(self, obj):
        if not obj.receipt_image:
            return 'رسیدی بارگذاری نشده است.'
        return obj.receipt_image.name

    @admin.display(description='رسید')
    def receipt_link(self, obj):
        # آدرس مستقیم فایل عمداً استفاده نمی‌شود: رسیدها در فضای خصوصی‌اند
        # و فقط از مسیر محافظت‌شده (با بررسی دسترسی) سرو می‌شوند.
        if not obj.receipt_image:
            return '—'
        return format_html('<a href="{}" target="_blank">مشاهده</a>', obj.receipt_url)

    @admin.display(description='پیش‌نمایش رسید')
    def receipt_preview(self, obj):
        if not obj.receipt_image:
            return 'رسیدی بارگذاری نشده است.'
        return format_html(
            '<a href="{0}" target="_blank">'
            '<img src="{0}" style="max-width:420px;max-height:520px;'
            'border:1px solid #ddd;border-radius:8px;" /></a>',
            obj.receipt_url,
        )

    @admin.action(description='✅ تایید رسید کارت‌به‌کارت و آزادسازی توکن')
    def approve_card_receipts(self, request, queryset):
        from .views_extended import _complete_purchase

        approved = 0
        skipped = 0
        for purchase in queryset.select_related('user', 'discount_code'):
            if purchase.payment_method != TokenPurchase.METHOD_CARD:
                skipped += 1
                continue
            if purchase.status == 'paid' or not purchase.receipt_image:
                skipped += 1
                continue

            ref = purchase.payment_ref_id or f'CARD-{purchase.id}'
            if _complete_purchase(purchase, ref_id=ref):
                TokenPurchase.objects.filter(pk=purchase.pk).update(
                    reviewed_by=request.user,
                    reviewed_at=timezone.now(),
                    updated_at=timezone.now(),
                )
                approved += 1
            else:
                skipped += 1

        self.message_user(
            request,
            f'{approved} رسید تایید و توکن آزاد شد. {skipped} مورد نادیده گرفته شد '
            f'(بدون رسید، غیرکارتی، یا قبلاً تاییدشده).'
        )

    @admin.action(description='❌ رد رسید کارت‌به‌کارت')
    def reject_card_receipts(self, request, queryset):
        rejected = queryset.exclude(status='paid').filter(
            payment_method=TokenPurchase.METHOD_CARD
        ).update(
            status='rejected',
            reviewed_by=request.user,
            reviewed_at=timezone.now(),
            updated_at=timezone.now(),
        )
        self.message_user(
            request,
            f'{rejected} رسید رد شد. کاربر می‌تواند رسید جدیدی بارگذاری کند.'
        )

    def save_model(self, request, obj, form, change):
        """تغییرِ وضعیت به «پرداخت شده» در همین فرم، توکن را هم شارژ می‌کند.

        باگِ قبلی: شارژ فقط در اکشن‌های فهرست انجام می‌شد. اگر مدیر در فرمِ خودِ خرید
        وضعیت را روی «پرداخت شده» می‌گذاشت و ذخیره می‌کرد، خرید «تاییدشده» دیده
        می‌شد ولی کیف پولِ صاحبِ حساب پر نمی‌شد و دفتر حساب هم سطری نمی‌گرفت.

        کار از همان مسیرِ idempotentِ _complete_purchase می‌گذرد تا شارژ، کد تخفیف و
        دفتر حساب دقیقاً مثلِ مسیرِ درگاه ثبت شوند. چون آن تابع روی خریدِ paid کاری
        نمی‌کند، وضعیتِ قبلی نگه داشته می‌شود و خودِ تابع آن را paid می‌کند.
        """
        from .views_extended import _complete_purchase

        previous_status = None
        if change and obj.pk:
            previous_status = (TokenPurchase.objects
                               .filter(pk=obj.pk).values_list('status', flat=True).first())

        if obj.status == 'paid' and previous_status != 'paid':
            obj.status = previous_status or 'under_review'
            super().save_model(request, obj, form, change)
            ref = obj.payment_ref_id or f'ADMIN-{obj.pk}'
            if _complete_purchase(obj, ref_id=ref):
                TokenPurchase.objects.filter(pk=obj.pk).update(
                    reviewed_by=request.user,
                    reviewed_at=timezone.now(),
                    updated_at=timezone.now(),
                )
                obj.refresh_from_db()
                obj.user.refresh_from_db()
                self.message_user(
                    request,
                    f'{obj.token_amount} توکن به حساب {obj.user.phone_number} اضافه شد '
                    f'(موجودی: {obj.user.get_effective_token_balance()}).',
                    level=messages.SUCCESS,
                )
            else:
                self.message_user(
                    request, 'این خرید از قبل پرداخت‌شده بود؛ توکن دوباره شارژ نشد.',
                    level=messages.WARNING,
                )
            return

        super().save_model(request, obj, form, change)

    @admin.action(description='🩹 شارژِ توکنِ خریدهای «پرداخت‌شده»ی شارژنشده')
    def charge_missing_tokens(self, request, queryset):
        """جبرانِ خریدهایی که قبلاً دستی paid شدند و توکنشان هرگز اضافه نشد.

        ملاکِ «شارژ شده» سطرِ دفترِ حساب است (token_grant با شناسهٔ همان خرید)، نه
        وضعیت؛ چون _complete_purchase روی خریدِ paid عمداً کاری نمی‌کند.
        """
        fixed = 0
        skipped = 0
        for purchase in queryset.select_related('user'):
            ref = f'purchase#{purchase.id}'
            already = LedgerEntry.objects.filter(
                entry_type=LedgerEntry.TYPE_TOKEN_GRANT, reference=ref
            ).exists()
            if purchase.status != 'paid' or already:
                skipped += 1
                continue
            purchase.user.add_tokens(purchase.token_amount)
            LedgerEntry.record(
                LedgerEntry.TYPE_TOKEN_GRANT,
                user=purchase.user,
                tokens=purchase.token_amount,
                reference=ref,
                description='جبرانِ شارژِ توکنِ خریدِ پرداخت‌شده (از پنل ادمین)',
            )
            TokenPurchase.objects.filter(pk=purchase.pk).update(
                reviewed_by=request.user, reviewed_at=timezone.now(), updated_at=timezone.now(),
            )
            fixed += 1
        self.message_user(
            request,
            f'{fixed} خرید شارژ شد. {skipped} مورد رد شد (پرداخت‌شده نبود یا قبلاً شارژ شده بود).'
        )

    @admin.action(description='تغییر وضعیت به پرداخت‌شده + شارژ توکن')
    def mark_as_paid_and_charge_tokens(self, request, queryset):
        """همان مسیرِ تاییدِ رسید، ولی بدونِ شرطِ کارت‌به‌کارت و رسید.

        عمداً از _complete_purchase استفاده می‌کند تا دفتر حساب و کد تخفیف هم مثلِ
        بقیهٔ مسیرها ثبت شوند (نسخهٔ قبلی توکن را شارژ می‌کرد ولی دفتر را نمی‌نوشت).
        """
        from .views_extended import _complete_purchase

        charged_count = 0
        skipped_count = 0
        for purchase in queryset.select_related('user', 'discount_code'):
            ref = purchase.payment_ref_id or f'ADMIN-{purchase.id}'
            if _complete_purchase(purchase, ref_id=ref):
                TokenPurchase.objects.filter(pk=purchase.pk).update(
                    reviewed_by=request.user,
                    reviewed_at=timezone.now(),
                    updated_at=timezone.now(),
                )
                charged_count += 1
            else:
                skipped_count += 1

        self.message_user(
            request,
            f'{charged_count} خرید پرداخت‌شده و شارژ شد. {skipped_count} مورد قبلاً paid بود.'
        )

    @admin.action(description='تغییر وضعیت خریدهای انتخاب‌شده به ناموفق')
    def mark_as_failed(self, request, queryset):
        updated = queryset.exclude(status='paid').update(status='failed')
        self.message_user(request, f'{updated} خرید به ناموفق تغییر وضعیت یافت.')

    @admin.action(description='تغییر وضعیت خریدهای انتخاب‌شده به لغوشده')
    def mark_as_cancelled(self, request, queryset):
        updated = queryset.exclude(status='paid').update(status='cancelled')
        self.message_user(request, f'{updated} خرید به لغوشده تغییر وضعیت یافت.')


