        except ClientProgram.DoesNotExist:
            return Response({'error': 'برنامه یافت نشد.'}, status=status.HTTP_404_NOT_FOUND)









@extend_schema(tags=['Programs'])
class ProgramShareCodeView(APIView):
    """کد یکبارمصرف دانلود برای برنامه‌ای که مربی ساخته است.

    این کد جای «کد دسترسی پنل» را نمی‌گیرد؛ مکمل آن است:

    * کد دسترسی پنل (`GymClient.access_code`): ورزشکار وارد پنل می‌شود و
      خودش اطلاعاتش را می‌دهد تا برنامه ساخته شود — زمان‌دار یا دائمی،
      بنا به تنظیم مربی، و ورود مجدد هم می‌دهد.
    * این کد: برنامه از قبل آماده است و ورزشکار فقط آن را دانلود می‌کند،
      **فقط یک بار**. دسترسی خود مربی از تاریخچه همیشگی است و این کد هیچ
      اثری بر آن ندارد.

    توکنی مصرف نمی‌شود؛ هزینه هنگام تولید برنامه از مربی کسر شده است.
    """
    permission_classes = [IsAuthenticated]

    @extend_schema(
        request=CreateProgramShareCodeSerializer,
        responses={201: ProgramShareCodeSerializer},
        description='ساخت کد یکبارمصرف دانلود برای یک برنامه.'
    )
    def post(self, request, program_id):
        try:
            program = _accessible_programs_queryset(request.user).get(id=program_id)
        except ClientProgram.DoesNotExist:
            return Response({'error': 'برنامه یافت نشد.'}, status=status.HTTP_404_NOT_FOUND)

        serializer = CreateProgramShareCodeSerializer(data=request.data)
        if not serializer.is_valid():
            return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

        section = serializer.validated_data.get('section') or 'both'

        # کد فقط برای بخشی که واقعاً تولید شده معنا دارد
        has_workout = bool(program.generated_workout)
        has_meal = bool(program.generated_meal_plan)
        if not has_workout and not has_meal:
            return Response(
                {'error': 'این برنامه هنوز محتوایی ندارد.'},
                status=status.HTTP_400_BAD_REQUEST,
            )
        if section == 'workout' and not has_workout:
            return Response(
                {'error': 'این برنامه بخش ورزشی ندارد.'},
                status=status.HTTP_400_BAD_REQUEST,
            )
        if section == 'meal' and not has_meal:
            return Response(
                {'error': 'این برنامه بخش غذایی ندارد.'},
                status=status.HTTP_400_BAD_REQUEST,
            )
        if section == 'both':
            # برنامه تک‌بخشی: کد را به همان بخش موجود محدود کن
            if not has_meal:
                section = 'workout'
            elif not has_workout:
                section = 'meal'

        expires_in = serializer.validated_data.get('expires_in_hours')
        expires_at = (
            timezone.now() + timedelta(hours=expires_in) if expires_in else None
        )

        share = ProgramShareCode.objects.create(
            program=program,
            created_by=request.user,
            section=section,
            expires_at=expires_at,
        )

        logger.info(
            f"Share code created for program #{program.id} "
            f"by {request.user.phone_number}"
        )
        return Response(
            ProgramShareCodeSerializer(share).data, status=status.HTTP_201_CREATED
        )

    @extend_schema(
        responses={200: ProgramShareCodeSerializer(many=True)},
        description='کدهای ساخته‌شده برای این برنامه.'
    )
    def get(self, request, program_id):
        try:
            program = _accessible_programs_queryset(request.user).get(id=program_id)
        except ClientProgram.DoesNotExist:
            return Response({'error': 'برنامه یافت نشد.'}, status=status.HTTP_404_NOT_FOUND)

        codes = program.share_codes.all()
        return Response(ProgramShareCodeSerializer(codes, many=True).data)


@extend_schema(tags=['Programs'])
class RedeemProgramCodeView(APIView):
    """دریافت برنامه با کد یکبارمصرف — بدون نیاز به حساب کاربری.

    ورزشکاری که مربی برایش برنامه ساخته، فقط یک کد دارد و نباید مجبور به
    ساخت حساب شود. کد پس از یک دانلود موفق مصرف می‌شود.
    """
    permission_classes = [AllowAny]
    throttle_classes = [SensitiveScopedRateThrottle]
    throttle_scope = 'client_access'

    @extend_schema(
        request=RedeemProgramCodeSerializer,
        responses={200: {'type': 'string', 'format': 'binary'}},
        description="""دانلود برنامه با کد یکبارمصرف.

        پاسخ موفق خود فایل PDF است. کد پس از این دانلود دیگر کار نمی‌کند.
        """
    )
    def post(self, request):
        serializer = RedeemProgramCodeSerializer(data=request.data)
        if not serializer.is_valid():
            return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

        code = serializer.validated_data['code'].strip()
        share = (
            ProgramShareCode.objects
            .select_related('program')
            .filter(code=code)
            .first()
        )

        if not share:
            return Response(
                {'error': 'کد معتبر نیست.'}, status=status.HTTP_404_NOT_FOUND
            )

        if share.is_expired:
            return Response(
                {'error': 'این کد منقضی شده است. از مربی خود کد جدید بگیرید.'},
                status=status.HTTP_403_FORBIDDEN,
            )

        if share.is_used:
            return Response(
                {
                    'error': 'این کد قبلاً استفاده شده است. هر کد فقط یک بار '
                             'کار می‌کند؛ برای دریافت دوباره از مربی خود کد '
                             'جدید بگیرید.'
                },
                status=status.HTTP_410_GONE,
            )

        # PDF پیش از مصرف کد ساخته می‌شود: اگر ساخت فایل شکست بخورد، کد
        # نباید سوخته باشد و ورزشکار بدون برنامه بماند.
        program = share.program
        try:
            if share.section == 'workout':
                content, _ = generate_workout_pdf(program)
            elif share.section == 'meal':
                content, _ = generate_meal_pdf(program)
            else:
                content, _ = generate_pdf(program)
        except Exception:
            logger.exception(f"PDF generation failed for share code #{share.id}")
            return Response(
                {'error': 'ساخت فایل ناموفق بود. لطفاً دوباره تلاش کنید.'},
                status=status.HTTP_500_INTERNAL_SERVER_ERROR,
            )

        # مصرف اتمیک: دو درخواست هم‌زمان با یک کد، فقط یکی موفق می‌شود
        if not share.redeem():
            return Response(
                {'error': 'این کد همین الان استفاده شد.'},
                status=status.HTTP_410_GONE,
            )

        logger.info(f"Share code #{share.id} redeemed for program #{program.id}")

        filename = f"program_{program.id}_{share.section}.pdf"
        response = HttpResponse(content, content_type='application/pdf')
        response['Content-Disposition'] = f'attachment; filename="{filename}"'
        return response


@extend_schema(tags=['Programs'])
class HistoryView(APIView):
    """تاریخچه برنامه‌های تولید شده"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        responses={200: ProgramHistorySerializer(many=True)},
        parameters=[
            OpenApiParameter(
                name='client_id',
                type=OpenApiTypes.INT,
                location=OpenApiParameter.QUERY,
                required=False,
                description='فقط مربی: محدود کردن نتایج به یک مشتری خاص (همان ID در /api/gym-clients/) — '
                            'هم برنامه‌هایی که مربی برای او ساخته و هم آنچه خودش ساخته'
            ),
            OpenApiParameter(
                name='program_id',
                type=OpenApiTypes.INT,
                location=OpenApiParameter.QUERY,
                required=False,
                description='محدود کردن نتایج به یک برنامه خاص'
            ),
        ],
        description="""دریافت لیست برنامه‌های تولید شده.
        - کاربر شخصی/ورزشکار: فقط برنامه‌های خودش.
        - مربی: برنامه‌هایی که خودش برای شاگردانش ساخته + تمام برنامه‌هایی که
          ورزشکاران متصل به باشگاهش با اکانت خودشان برای خودشان ساخته‌اند.
        - با client_id یا program_id قابل فیلتر است.
        """
    )
    def get(self, request):
        # برنامه‌ای که حداقل یک بخش غیرخالی (ورزشی یا غذایی) دارد در تاریخچه می‌آید
        programs = _accessible_programs_queryset(request.user).filter(
            (Q(generated_workout__isnull=False) & ~Q(generated_workout='')) |
            (Q(generated_meal_plan__isnull=False) & ~Q(generated_meal_plan=''))
        )

        client_id = request.query_params.get('client_id')
        if client_id:
            try:
                gym_client = GymClient.objects.get(id=int(client_id), gym_owner=request.user)
            except (ValueError, GymClient.DoesNotExist):
                return Response({'error': 'مشتری یافت نشد.'}, status=status.HTTP_404_NOT_FOUND)
            programs = programs.filter(_client_programs_filter(request.user, gym_client))

        program_id = request.query_params.get('program_id')
        if program_id:
            try:
                programs = programs.filter(id=int(program_id))
            except ValueError:
                return Response({'error': 'program_id نامعتبر است.'}, status=status.HTTP_400_BAD_REQUEST)

        programs = programs.order_by('-created_at')
        data = ProgramHistorySerializer(programs, many=True).data
        return Response(data)





@extend_schema(tags=['Programs'])
class GenerateWorkoutPDFView(APIView):
    """تولید PDF فقط برای برنامه ورزشی"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        responses={200: {'type': 'string', 'format': 'binary'}},
        parameters=[
            OpenApiParameter(
                name='program_id',
                type=OpenApiTypes.INT,
                location=OpenApiParameter.PATH,
                description='شناسه برنامه'
            )
        ],
        description="تولید فایل PDF فقط برای برنامه ورزشی"
    )
    def get(self, request, program_id):
        try:
            client = _accessible_programs_queryset(request.user).get(id=program_id)
        except ClientProgram.DoesNotExist:
            return Response({'error': 'برنامه یافت نشد.'}, status=status.HTTP_404_NOT_FOUND)

        if not client.generated_workout:
            return Response({'error': 'برنامه ورزشی تولید نشده است.'}, status=status.HTTP_400_BAD_REQUEST)

        try:
            content, _ = generate_workout_pdf(client)
        except Exception:
            logger.exception(f"Error generating workout PDF for program {program_id}")
            return Response({'error': 'خطا در تولید PDF. لطفاً دوباره تلاش کنید.'},
                            status=status.HTTP_500_INTERNAL_SERVER_ERROR)

        response = HttpResponse(content, content_type='application/pdf')
        response['Content-Disposition'] = f'attachment; filename="workout_{client.name}_{client.id}.pdf"'
        return response


@extend_schema(tags=['Programs'])
class GenerateMealPDFView(APIView):
    """تولید PDF فقط برای برنامه غذایی"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        responses={200: {'type': 'string', 'format': 'binary'}},
        parameters=[
            OpenApiParameter(
                name='program_id',
                type=OpenApiTypes.INT,
                location=OpenApiParameter.PATH,
                description='شناسه برنامه'
            )
        ],
        description="تولید فایل PDF فقط برای برنامه غذایی"
    )
    def get(self, request, program_id):
        try:
            client = _accessible_programs_queryset(request.user).get(id=program_id)
        except ClientProgram.DoesNotExist:
            return Response({'error': 'برنامه یافت نشد.'}, status=status.HTTP_404_NOT_FOUND)

        if not client.generated_meal_plan:
