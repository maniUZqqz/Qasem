[Unit]
Description=NMarketing (UpMarket) web — gunicorn :8041
After=network.target redis-server.service

[Service]
User=root
WorkingDirectory=/var/www/NM/upmarket/backend
Environment=PYTHONIOENCODING=utf-8
ExecStart=/var/www/NM/upmarket/venv/bin/gunicorn config.wsgi:application --bind 127.0.0.1:8041 --workers 2 --threads 8 --timeout 600 --graceful-timeout 30 --access-logfile /var/www/NM/upmarket/logs/web-access.log --error-logfile /var/www/NM/upmarket/logs/web-error.log
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
