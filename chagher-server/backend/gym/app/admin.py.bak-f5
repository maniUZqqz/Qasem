@admin.register(PricingRule)
class PricingRuleAdmin(admin.ModelAdmin):
    """قاعده‌های قیمت — «تا این تاریخ رایگان»، «تا این تعداد رایگان»، «بعدش N توکن».

    ⚠ ترتیب مهم است: اولین قاعده‌ای که شرطش بخورد برنده است. با «آزمونِ قیمت»
    (دکمهٔ بالای همین صفحه) می‌توانی پیش از اینکه کسی پول بدهد ببینی برای یک
    کاربرِ مشخص کدام قاعده برنده می‌شود و چرا.
    """
    list_display = ['priority', 'title', 'feature', 'verdict', 'human_short',
                    'is_active']
    list_display_links = ['title']
    list_editable = ['priority', 'is_active']
    list_filter = ['is_active', 'feature', 'mode', 'audience']
    search_fields = ['title', 'note']
    autocomplete_fields = ['user']
    readonly_fields = ['guide', 'created_at', 'updated_at']
    save_on_top = True

    fieldsets = [
        ('راهنما', {'fields': ('guide',)}),
        ('شناسه', {'fields': ('title', 'is_active', 'priority', 'feature')}),
        ('برای چه کسانی', {'fields': ('audience', 'user')}),
        ('شرطِ زمان', {
            'fields': ('starts_at', 'ends_at', 'signup_days_from', 'signup_days_to'),
            'description': 'دو جور زمان: تاریخِ تقویمی (کمپین) یا روزِ چندمِ '
                           'ثبت‌نامِ خودِ کاربر (دورهٔ آزمایشی). هر کدام را '
                           'خالی بگذاری یعنی بی‌قید.'}),
        ('شرطِ تعداد', {
            'fields': ('count_scope', 'count_from', 'count_to'),
            'description': 'مثلاً «چندمین برنامهٔ هوش مصنوعیِ این کاربر» با '
                           'بازهٔ «از ۰ تا ۵» یعنی پنج تای اول.'}),
        ('حکم', {'fields': ('mode', 'token_cost', 'blocked_message')}),
        ('یادداشت', {'fields': ('note', 'created_at', 'updated_at')}),
    ]

    @admin.display(description='حکم', ordering='mode')
    def verdict(self, obj):
        color = {'free': '#15803d', 'tokens': '#126F85', 'blocked': '#b02a2a'}
        txt = obj.get_mode_display()
        if obj.mode == 'tokens':
            txt = '%d توکن' % obj.token_cost
        return format_html('<b style="color:{}">{}</b>', color.get(obj.mode, '#000'), txt)

    @admin.display(description='شرح')
    def human_short(self, obj):
        return obj.human()

    @admin.display(description='چطور کار می‌کند')
    def guide(self, obj):
        return format_html(
            '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:10px;'
            'padding:14px;line-height:2.1;max-width:760px">'
            '<b style="color:#163F75">قاعده‌ها از بالا به پایین سنجیده می‌شوند و '
            '«اولین قاعده‌ای که شرطش بخورد» حکم می‌دهد.</b><br>'
            'هر شرطی که خالی بگذاری یعنی «بی‌قید». پس قاعده‌ای بدونِ هیچ شرطی، '
            'همیشه می‌خورد — آن را با اولویتِ بزرگ (مثلاً ۹۰۰) آخر بگذار تا '
            'نقشِ «قیمتِ پایه» را بازی کند.<br><br>'
            '<b>چهار نمونه:</b><br>'
            '۱) <i>تا آخرِ مهر همه‌چیز رایگان</i> — «تا تاریخ» را ۱ آبان بگذار، '
            'حکم «رایگان»، اولویت ۱۰.<br>'
            '۲) <i>۵ برنامهٔ اولِ هر مربی رایگان</i> — شمارش «چندمین برنامهٔ هوش '
            'مصنوعیِ این کاربر»، از ۰ تا ۵، حکم «رایگان».<br>'
            '۳) <i>از ششم به بعد ۶۰ توکن</i> — همان شمارش، «از ۵»، «تا» خالی، '
            'حکم «با توکن» و عدد ۶۰.<br>'
            '۴) <i>۱۰ روزِ اولِ ثبت‌نام رایگان</i> — «تا روزِ چندمِ ثبت‌نام» = ۱۰.'
            '<br><br>'
            '<b style="color:#b02a2a">اگر هیچ قاعده‌ای نخورد</b>، سامانه همان '
            'رفتارِ قدیمی را ادامه می‌دهد (۵ برنامهٔ رایگان، ۵۰/۲۵ توکن، دورهٔ '
            'آزمایشیِ دستی). پس تا قاعده ننویسی چیزی عوض نمی‌شود.<br>'
            '<b>پیش از اینکه زنده‌اش کنی، حتماً «آزمونِ قیمت» را بزن.</b>'
            '</div>')

    # ── آزمونِ قیمت ──
    def get_urls(self):
        from django.urls import path as _p
        return [_p('simulate/', self.admin_site.admin_view(self.simulate),
                   name='pricing-simulate')] + super().get_urls()

    def changelist_view(self, request, extra_context=None):
        from django.urls import reverse
        extra_context = extra_context or {}
        extra_context['title'] = 'قاعده‌های قیمت'
        resp = super().changelist_view(request, extra_context)
        try:
            resp.context_data['subtitle'] = mark_safe(
                '<a href="%s" style="font-weight:700;color:#126F85">آزمونِ قیمت ↗</a>'
                % reverse('admin:pricing-simulate'))
        except Exception:
            pass
        return resp

    def simulate(self, request):
        """صفحهٔ «اگر این کاربر الان بزند، چقدر می‌شود و چرا»."""
        from django.http import HttpResponse
        from .pricing import FEATURE_CHOICES, explain, usage_count, F_ANY
        from .models import CustomUser

        uid = request.GET.get('user') or ''
        feat = request.GET.get('feature') or 'ai_both'
        athlete = request.GET.get('athlete') or ''

        opts = ''.join(
            '<option value="%s"%s>%s %s</option>'
            % (u.id, ' selected' if str(u.id) == uid else '',
               u.phone_number, (u.gym_name or ''))
            for u in CustomUser.objects.all().order_by('id'))
        fopts = ''.join(
            '<option value="%s"%s>%s</option>'
            % (k, ' selected' if k == feat else '', v)
            for k, v in FEATURE_CHOICES if k != F_ANY)

        body = ''
        user = CustomUser.objects.filter(pk=uid).first() if uid else None
        if user:
            key = int(athlete) if athlete.isdigit() else (athlete or None)
            winner, rows = explain(user, feat, key)
            if winner is None:
                head = ('<div style="background:#fff7e6;border:1px solid #f0c36d;'
                        'padding:12px;border-radius:10px"><b>هیچ قاعده‌ای نخورد</b>'
                        ' — سامانه رفتارِ پیش‌فرضِ قدیمی را اجرا می‌کند.</div>')
            else:
                txt = ('رایگان' if winner.mode == 'free'
                       else ('%d توکن' % winner.cost if winner.mode == 'tokens'
                             else 'بسته'))
                head = ('<div style="background:#eaf7ee;border:1px solid #9ad3ab;'
                        'padding:12px;border-radius:10px"><b>نتیجه: %s</b><br>'
                        'برندهٔ قاعده: «%s» (اولویت %s) — %s</div>'
                        % (txt, winner.rule.title, winner.rule.priority, winner.reason))
            tr = ''.join(
                '<tr style="background:%s"><td>%s</td><td>%s</td><td>%s</td>'
                '<td>%s</td><td>%s</td></tr>'
                % ('#eaf7ee' if win else ('#fff' if hit else '#fafafa'),
                   r.priority, r.title, r.human(),
                   ('✓ می‌خورد' if hit else '✗'), why)
                for r, hit, why, win in rows)
            counts = ''.join(
                '<li>%s: <b>%s</b></li>' % (lbl, usage_count(user, sc, feat, key))
                for sc, lbl in [
                    ('user_ai', 'برنامه‌های هوش مصنوعیِ این کاربر'),
                    ('user_ai_type', 'از همین نوع'),
                    ('user_manual', 'برنامه‌های دستیِ این کاربر'),
                    ('user_all', 'همهٔ برنامه‌ها')])
            body = (head + '<ul style="line-height:2">' + counts + '</ul>'
                    + '<table border=1 cellpadding=7 style="border-collapse:collapse;'
                      'width:100%;font-size:13px"><tr style="background:#eef2f8">'
                      '<th>اولویت</th><th>نام</th><th>شرط ⇒ حکم</th><th>سنجش</th>'
                      '<th>چرا</th></tr>' + tr + '</table>')

        return HttpResponse(
            '<!doctype html><html lang="fa" dir="rtl"><head><meta charset="utf-8">'
            '<title>آزمونِ قیمت</title><style>'
            'body{font-family:Tahoma,sans-serif;background:#f4f6fb;padding:22px;color:#1b2b45}'
            'h2{color:#163F75} select,button{padding:8px 10px;border-radius:8px;'
            'border:1px solid #cbd5e1;font-family:inherit}'
            'button{background:#126F85;color:#fff;border:0;font-weight:700;cursor:pointer}'
            'th,td{text-align:right}</style></head><body>'
            '<h2>آزمونِ قیمت — بدونِ اینکه چیزی ثبت شود</h2>'
            '<p>یک کاربر و یک مورد انتخاب کن تا ببینی همین الان چقدر برایش '
            'حساب می‌شود و <b>کدام قاعده</b> برنده شده است.</p>'
            '<form method="get" style="margin-bottom:18px;display:flex;gap:8px;flex-wrap:wrap">'
            '<select name="user"><option value="">— کاربر —</option>' + opts + '</select>'
            '<select name="feature">' + fopts + '</select>'
            '<input name="athlete" placeholder="نام یا شناسهٔ ورزشکار (برای برنامهٔ دستی)" '
            'value="' + athlete + '" style="padding:8px;border-radius:8px;border:1px solid #cbd5e1">'
            '<button type="submit">بسنج</button></form>' + body +
            '<p style="margin-top:18px"><a href="../">بازگشت به قاعده‌ها</a></p>'
            '</body></html>')


@admin.register(ExerciseAlias)
class ExerciseAliasAdmin(admin.ModelAdmin):
    """نام‌های دومِ حرکت‌ها.

    هر نامی که این‌جا ثبت شود، در تطبیقِ متنِ برنامه دقیقاً مثلِ نامِ اصلی عمل
    می‌کند. این سریع‌ترین راهِ بالا بردنِ نرخِ لینک است: الگوریتم تا جایی حدس
    می‌زند، از آن به بعد شما می‌گویید «این همان است».
    """
    list_display = ['name', 'target_name', 'note', 'created_at']
    search_fields = ['name', 'exercise__name_fa', 'exercise__name', 'exercise__external_id']
    autocomplete_fields = ['exercise']
    list_per_page = 50

    @admin.display(description='حرکتِ اصلی', ordering='exercise__name_fa')
    def target_name(self, obj):
        return obj.exercise.name_fa or obj.exercise.name


@admin.register(UnmatchedExercise)
class UnmatchedExerciseAdmin(BrandStampMixin, admin.ModelAdmin):
    """نام‌هایی که در برنامه‌ها آمده‌اند ولی به کتابخانه وصل نشدند.

    خودکار پر می‌شود (هنگامِ ساختِ PDF). دو راهِ بستنِ هر ردیف:
      ۱) حرکت را داریم، اسمش فرق دارد ⇒ «وصل‌شده به» را پر کن و ذخیره؛
         خودش «نامِ دیگر» می‌سازد و از این به بعد لینک می‌خورد.
      ۲) اصلاً نداریم ⇒ کنشِ «ساختِ حرکتِ تازه از روی این نام».
    """
    list_display = ['name', 'seen_count', 'status_badge', 'linked_exercise',
                    'sample_line', 'last_seen']
    list_filter = ['status']
    search_fields = ['name', 'sample_line']
    autocomplete_fields = ['linked_exercise']
    readonly_fields = ['seen_count', 'first_seen', 'last_seen', 'sample_line',
                       'how_to', 'source_badge', 'gif_preview']
    stamp_fields = ('new_gif',)
    list_filter = ['status', 'source']
    ordering = ['-seen_count']
    list_per_page = 50
    actions = ['act_create_exercise', 'act_ignore', 'act_reopen']

    fieldsets = [
        ('نام', {'fields': ('name', 'source_badge', 'sample_line', 'seen_count', 'how_to')}),
        ('راهِ ۱ — این حرکت را با نامِ دیگری داریم',
         {'fields': ('linked_exercise',),
          'description': 'حرکتِ درست را انتخاب کن و ذخیره بزن — بقیه‌اش خودکار است.'}),
        ('راهِ ۲ — اصلاً نداریم، همین‌جا بسازش',
         {'fields': ('new_name_en', 'new_gif', 'gif_preview', 'create_now'),
          'description': 'گیفِ آموزش را آپلود کن، تیکِ «با ذخیره، حرکتِ تازه بساز» '
                         'را بزن و ذخیره کن. حرکت ساخته می‌شود، گیف رویش می‌نشیند '
                         'و لوگوی چغر هم خودکار روی گیف می‌افتد.'}),
        ('وضعیت و تاریخ', {'fields': ('status', 'first_seen', 'last_seen')}),
    ]

    @admin.display(description='از کجا آمده', ordering='source')
    def source_badge(self, obj):
        return obj.get_source_display() if obj.pk else '—'

    @admin.display(description='پیش‌نمایشِ گیف')
    def gif_preview(self, obj):
        if not (obj.pk and obj.new_gif):
            return 'هنوز گیفی آپلود نشده.'
        try:
            return format_html(
                '<img src="{}" style="max-width:320px;border-radius:10px" />',
                obj.new_gif.url)
        except Exception:
            return 'فایل هست ولی نمایش نشد.'

    def _spawn_exercise(self, row, request=None):
        """یک حرکتِ تازه از روی این نام می‌سازد و گیفش را منتقل می‌کند."""
        from .models import ExerciseLibrary
        # شناسه‌ای که با دیتاستِ اصلی (۰۰۰۱…) قاطی نشود
        n = ExerciseLibrary.objects.filter(external_id__startswith='n').count() + 1
        ext = 'n%04d' % n
        while ExerciseLibrary.objects.filter(external_id=ext).exists():
            n += 1
            ext = 'n%04d' % n
        ex = ExerciseLibrary.objects.create(
            external_id=ext,
            name=(row.new_name_en or row.name),
            name_fa=row.name,
            is_public=True, is_active=True,
        )
        if row.new_gif:
            # همان فایل را به حرکت می‌دهیم (کپیِ تازه، تا حذفِ این ردیف فایل را نبرد)
            from django.core.files.base import ContentFile
            row.new_gif.open('rb')
            data = row.new_gif.read()
            row.new_gif.close()
            fname = (row.new_gif.name or 'exercise.gif').rsplit('/', 1)[-1]
            ex.gif.save(fname, ContentFile(data), save=True)
        row.linked_exercise = ex
        row.status = UnmatchedExercise.STATUS_ADDED
        row.create_now = False
        row.save(update_fields=['linked_exercise', 'status', 'create_now'])
        ExerciseAlias.objects.get_or_create(
            name=row.name, defaults={'exercise': ex, 'note': 'از نامِ بی‌تطبیق'})
        return ex

    @admin.display(description='وضعیت', ordering='status')
    def status_badge(self, obj):
        colors = {'new': '#b45309', 'linked': '#15803d', 'added': '#126F85', 'ignored': '#6b7280'}
        return format_html('<b style="color:{}">{}</b>',
                           colors.get(obj.status, '#000'), obj.get_status_display())

    @admin.display(description='راهنما')
    def how_to(self, obj):
        return format_html(
            '<div style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;'
            'padding:12px;line-height:2;max-width:620px">'
            '<b>۱) این حرکت را داریم، فقط اسمش فرق دارد:</b> در «وصل‌شده به» '
            'حرکتِ درست را انتخاب کن و ذخیره بزن. خودش یک «نامِ دیگر» می‌سازد و '
            'از همان لحظه این نام لینک می‌خورد.<br>'
            '<b>۲) اصلاً نداریم:</b> از فهرست انتخابش کن و کنشِ '
            '«ساختِ حرکتِ تازه از روی این نام» را بزن.<br>'
            '<b>۳) بی‌ربط است</b> (مثلِ «تردمیل ۱۰ دقیقه»): کنشِ «نادیده بگیر».'
            '</div>')

    def save_model(self, request, obj, form, change):
        """دو راه: وصل‌کردن به حرکتِ موجود، یا ساختنِ حرکتِ تازه با گیف."""
        super().save_model(request, obj, form, change)
        # ⚠ اول مهرِ لوگو روی گیفِ تازه، بعد انتقالش به حرکت — وگرنه حرکت
        #   نسخهٔ بی‌مهر را می‌گیرد.
        self._stamp_changed_files(request, obj, form)

        if obj.create_now and not obj.linked_exercise:
            try:
                ex = self._spawn_exercise(obj, request)
            except Exception as exc:
                self.message_user(request, 'ساختِ حرکت نشد: %s' % exc, level=messages.ERROR)
                return
            from .exercise_match import reset_cache
            try:
                reset_cache()
            except Exception:
                pass
            self.message_user(
                request,
                'حرکتِ «%s» (کدِ %s) ساخته شد%s و این نام از حالا به آن وصل است.'
                % (ex.name_fa or ex.name, ex.external_id,
                   ' با گیف' if ex.gif else ' — هنوز گیف ندارد'))
            return

        if obj.linked_exercise and obj.status != UnmatchedExercise.STATUS_LINKED:
            alias, created = ExerciseAlias.objects.get_or_create(
                name=obj.name, defaults={'exercise': obj.linked_exercise,
                                         'note': 'از نامِ بی‌تطبیق'})
            if not created and alias.exercise_id != obj.linked_exercise_id:
                alias.exercise = obj.linked_exercise
                alias.save()
            obj.status = UnmatchedExercise.STATUS_LINKED
            obj.save(update_fields=['status'])
            self.message_user(request, 'نامِ «%s» به «%s» وصل شد و از حالا لینک می‌خورد.'
                              % (obj.name, obj.linked_exercise.name_fa or obj.linked_exercise.name))

    @admin.action(description='ساختِ حرکتِ تازه از روی این نام (بی‌گیف)')
    def act_create_exercise(self, request, queryset):
        made = 0
        for row in queryset.filter(linked_exercise__isnull=True):
            self._spawn_exercise(row, request)
            made += 1
        try:
            from .exercise_match import reset_cache
            reset_cache()
        except Exception:
            pass
        self.message_user(request, '%d حرکتِ تازه ساخته شد. یادت باشد تصویر و '
                                   'آموزششان را در «کتابخانهٔ حرکت‌ها» اضافه کنی.' % made)

    @admin.action(description='نادیده بگیر (بی‌ربط است)')
    def act_ignore(self, request, queryset):
        n = queryset.update(status=UnmatchedExercise.STATUS_IGNORED)
        self.message_user(request, '%d ردیف نادیده گرفته شد.' % n)

    @admin.action(description='برگرداندن به «بررسی نشده»')
    def act_reopen(self, request, queryset):
        n = queryset.update(status=UnmatchedExercise.STATUS_NEW)
        self.message_user(request, '%d ردیف باز شد.' % n)
