": 20, "type": "Note", "pos": [1200.0, 1260.0], "size": [700, 170], "flags": {}, "order": 0, "mode": 0, "inputs": [], "outputs": [], "title": "Image Editing Mode - How it works", "properties": {"text": ""}, "widgets_values": ["1) Load Image = the photo you want to edit.\n2) Resize node keeps it at 1920x1080 (change if your photo has a different aspect ratio).\n3) VAE Encode turns it into a latent instead of starting from empty noise.\n4) KSampler 'denoise' controls how much changes: 0.3-0.5 = subtle edit, 0.6-0.8 = bigger change, 1.0 = ignores the photo completely.\n5) Write what you want changed in the Positive prompt (node 4).\n6) The old 'Empty Latent Image' node is now disabled (bypassed) — re-enable it and reconnect if you ever want pure text-to-image again."], "color": "#222", "bgcolor": "#000"}], "links": [[1, 1, 0, 2, 0, "MODEL"], [3, 3, 0, 2, 2, "CONDITIONING"], [4, 1, 1, 4, 0, "CLIP"], [5, 1, 1, 3, 0, "CLIP"], [7, 2, 0, 6, 0, "LATENT"], [8, 1, 2, 6, 1, "VAE"], [9, 6, 0, 7, 0, "IMAGE"], [20, 16, 0, 17, 0, "IMAGE"], [21, 17, 0, 18, 0, "IMAGE"], [22, 1, 2, 18, 1, "VAE"], [23, 4, 0, 19, 0, "CONDITIONING"], [24, 19, 0, 2, 1, "CONDITIONING"], [25, 18, 0, 2, 3, "LATENT"]], "groups": [{"id": 1, "title": "Image Input (New)", "bounding": [1180, 560, 1180, 900], "color": "#3f789e", "font_size": 22, "flags": {}}], "config": {}, "extra": {"ds": {"scale": 1, "offset": [-1178.075789022113, -18.788235470924995]}, "frontendVersion": "1.42.15", "VHS_latentpreview": false, "VHS_latentpreviewrate": 0, "VHS_MetadataImage": true, "VHS_KeepIntermediate": true}, "version": 0.4}