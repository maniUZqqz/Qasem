def _accessible_programs_queryset(user):
    """برنامه‌های قابل مشاهده برای این کاربر.

    کاربر عادی/شخصی فقط برنامه‌های خودش را می‌بیند. مربی علاوه بر برنامه‌های
    خودش (که مستقیماً برای شاگردانش ساخته)، برنامه‌هایی را هم می‌بیند که
    ورزشکاران متصل به باشگاهش با اکانت خودشان برای خودشان ساخته‌اند —
    چون ClientProgram.user یعنی «کسی که درخواست را زده»، نه لزوماً مالک باشگاه.
    """
    if user.account_type == CustomUser.ACCOUNT_TYPE_COACH:
        client_user_ids = GymClient.objects.filter(
            gym_owner=user, client_user__isnull=False
        ).values_list('client_user_id', flat=True)
        return ClientProgram.objects.filter(Q(user=user) | Q(user_id__in=client_user_ids))
    return ClientProgram.objects.filter(user=user)


def _client_programs_filter(coach, gym_client):
    """فیلتر «برنامه‌های این مشتری» از دید مربی.

    یک مشتری دو جور برنامه دارد و هر دو باید دیده شوند، وگرنه مربی بعد از
    ساختن برنامه، آن را در تاریخچه‌ی همان مشتری پیدا نمی‌کند و نمی‌تواند
    ویرایشش کند:
      ۱) برنامه‌ای که خودِ ورزشکار با اکانتش ساخته (user = اکانت ورزشکار)
      ۲) برنامه‌ای که مربی برای او ساخته (user = مربی، name = نام مشتری)
    حالت دوم تنها راه شناسایی‌اش نام مشتری است، چون ClientProgram رابطه‌ی
    مستقیمی با GymClient ندارد. مشتری‌ای که هنوز کدش را فعال نکرده فقط
    حالت دوم را دارد.
    """
    condition = Q(pk__in=[])  # شرط همیشه-غلط به‌عنوان نقطه شروع
    if gym_client.client_user_id:
        condition |= Q(user_id=gym_client.client_user_id)
    if gym_client.name:
        condition |= Q(user=coach, name=gym_client.name)
    return condition


# ==================== Authentication Views ====================

@extend_schema(tags=['Authentication'])
class RegisterView(APIView):
    """ثبت‌نام کاربر جدید"""
    permission_classes = [AllowAny]
    serializer_class = RegisterSerializer

    @extend_schema(
        request=RegisterSerializer,
        responses={201: UserSerializer},
        description="ثبت‌نام کاربر جدید با شماره تلفن و رمز عبور. فیلد gym_name اختیاری است."
    )
    def post(self, request):
        serializer = RegisterSerializer(data=request.data)
        if serializer.is_valid():
            user = serializer.save()
            token, _ = Token.objects.get_or_create(user=user)
            logger.info(f"New user registered: {user.phone_number} (gym: {user.gym_name or '-'})")
            return Response({
                'user': UserSerializer(user).data,
                'token': token.key,
                'message': 'ثبت‌نام با موفقیت انجام شد.'
            }, status=status.HTTP_201_CREATED)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)


@extend_schema(tags=['Authentication'])
class PersonalRegisterView(APIView):
    """ثبت‌نام کاربر شخصی (B2C) — بدون نیاز به باشگاه"""
    permission_classes = [AllowAny]
    serializer_class = PersonalRegisterSerializer

    @extend_schema(
        request=PersonalRegisterSerializer,
        responses={201: UserSerializer},
        description="""ثبت‌نام کاربر شخصی که مستقل از باشگاه برنامه می‌گیرد.
        این حساب به هیچ باشگاهی متصل نیست و به بخش‌های مدیریت باشگاه دسترسی ندارد.
        """
    )
    def post(self, request):
        serializer = PersonalRegisterSerializer(data=request.data)
        if serializer.is_valid():
            user = serializer.save()
            token, _ = Token.objects.get_or_create(user=user)
            logger.info(f"New personal (B2C) user registered: {user.phone_number}")
            return Response({
                'user': UserSerializer(user).data,
                'token': token.key,
                'message': 'ثبت‌نام با موفقیت انجام شد.'
            }, status=status.HTTP_201_CREATED)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)


@extend_schema(tags=['Authentication'])
class LoginView(APIView):
    """ورود کاربر"""
    permission_classes = [AllowAny]
    serializer_class = LoginSerializer
    throttle_classes = [SensitiveScopedRateThrottle]
    throttle_scope = 'login'

    @extend_schema(
        request=LoginSerializer,
        responses={200: UserSerializer},
        description="ورود کاربر با شماره تلفن و رمز عبور"
    )
    def post(self, request):
        serializer = LoginSerializer(data=request.data)
        if serializer.is_valid():
            user = serializer.validated_data['user']
            token, _ = Token.objects.get_or_create(user=user)
            logger.info(f"User logged in: {user.phone_number}")
            return Response({
                'user': UserSerializer(user).data,
                'token': token.key,
                'message': 'ورود با موفقیت انجام شد.'
            })
        logger.warning(f"Failed login attempt for phone: {request.data.get('phone_number', '-')}")
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)


@extend_schema(tags=['Authentication'])
class LogoutView(APIView):
    """خروج کاربر"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        # خروج بدنه‌ای نمی‌گیرد؛ اعلام صریح جلوی حدس‌زدن سریالایزر را می‌گیرد
        request=None,
        responses={200: {'type': 'object', 'properties': {'message': {'type': 'string'}}}},
        description="خروج کاربر و حذف توکن"
    )
    def post(self, request):
        request.user.auth_token.delete()
        return Response({'message': 'خروج با موفقیت انجام شد.'})


@extend_schema(tags=['Authentication'])
class PasswordResetRequestView(APIView):
    """درخواست کد بازیابی رمز عبور (مرحله اول)"""
    permission_classes = [AllowAny]
    serializer_class = PasswordResetRequestSerializer
    throttle_classes = [SensitiveScopedRateThrottle]
    throttle_scope = 'password_reset'

    @extend_schema(
        request=PasswordResetRequestSerializer,
        responses={200: {'type': 'object', 'properties': {'message': {'type': 'string'}}}},
        description="""درخواست بازیابی رمز عبور.
        اگر شماره در سامانه ثبت شده باشد، یک کد ۴ رقمی پیامک می‌شود
        (اعتبار ۱۰ دقیقه). سپس با POST /api/auth/password-reset/confirm/ رمز جدید تعیین کنید.
        پاسخ برای شماره ناموجود هم یکسان است تا وجود حساب افشا نشود.
        """
    )
    def post(self, request):
        serializer = PasswordResetRequestSerializer(data=request.data)
        if not serializer.is_valid():
            return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

        phone = serializer.validated_data['phone_number'].strip()
        user = CustomUser.objects.filter(phone_number=phone).first()
        if user:
            otp = PasswordResetOTP.issue(user)
            sms = SMSService.get_active_service()
            if sms:
                result = sms.send_password_reset_code(phone, otp.code)
                if not result.get('success'):
                    logger.error(f"Failed to send password reset SMS to {phone}: {result.get('error')}")
            else:
                # بدون سرویس پیامکِ فعال: کد در صفِ گیت‌وی پیامک (گوشی) می‌رود
                SMSOutbox.enqueue(
                    phone, otp.code, purpose=SMSOutbox.PURPOSE_PASSWORD_RESET,
                    ttl_seconds=PasswordResetOTP.OTP_EXPIRY_MINUTES * 60,
                )
            logger.info(f"Password reset code issued for user: {phone}")
        else:
            logger.warning(f"Password reset requested for unknown phone: {phone}")

        return Response({
            'message': 'اگر این شماره در سامانه ثبت شده باشد، کد تایید پیامک می‌شود.'
        })


@extend_schema(tags=['Authentication'])
class PasswordResetConfirmView(APIView):
    """تایید کد بازیابی و تعیین رمز جدید (مرحله دوم)"""
    permission_classes = [AllowAny]
    serializer_class = PasswordResetConfirmSerializer
    throttle_classes = [SensitiveScopedRateThrottle]
    throttle_scope = 'password_reset_confirm'

    @extend_schema(
        request=PasswordResetConfirmSerializer,
        responses={200: {'type': 'object', 'properties': {'message': {'type': 'string'}}}},
        description="""تعیین رمز جدید با کد پیامک‌شده.
        کد یکبارمصرف است، ۱۰ دقیقه اعتبار دارد و پس از ۵ تلاش ناموفق باطل می‌شود.
        پس از تغییر موفق، همه توکن‌های ورود قبلی باطل می‌شوند.
        """
    )
    def post(self, request):
        serializer = PasswordResetConfirmSerializer(data=request.data)
        if not serializer.is_valid():
            return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

        phone = serializer.validated_data['phone_number'].strip()
        code = serializer.validated_data['code']
        invalid_response = Response(
            {'error': 'کد تایید نامعتبر یا منقضی است.'},
            status=status.HTTP_400_BAD_REQUEST,
        )

        user = CustomUser.objects.filter(phone_number=phone).first()
        otp = None
        if user:
            otp = PasswordResetOTP.objects.filter(user=user, is_used=False).order_by('-created_at').first()

        if not otp or otp.is_expired() or otp.attempts >= PasswordResetOTP.MAX_ATTEMPTS:
            logger.warning(f"Password reset confirm failed (no valid OTP) for phone: {phone}")
            return invalid_response

        if otp.code != code:
            otp.register_failed_attempt()
            logger.warning(f"Password reset confirm wrong code for phone: {phone} (attempt {otp.attempts})")
            return invalid_response

        otp.is_used = True
        otp.save(update_fields=['is_used'])

        user.set_password(serializer.validated_data['new_password'])
        user.save(update_fields=['password'])

        # ابطال همه نشست‌های قبلی
        Token.objects.filter(user=user).delete()

        logger.info(f"Password reset completed for user: {phone}")
        return Response({'message': 'رمز عبور با موفقیت تغییر کرد. اکنون با رمز جدید وارد شوید.'})


@extend_schema(tags=['Authentication'])
class ChangePasswordView(APIView):
    """تغییر رمز عبور کاربر لاگین‌شده (مربی یا مشتری)"""
    permission_classes = [IsAuthenticated]
    serializer_class = ChangePasswordSerializer

    @extend_schema(
        request=ChangePasswordSerializer,
        responses={200: {'type': 'object', 'properties': {
            'message': {'type': 'string'},
            'token': {'type': 'string'},
        }}},
        description="""تغییر رمز عبور با تایید رمز فعلی.
        - نیاز به احراز هویت دارد
        - پس از تغییر موفق، توکن قبلی باطل و توکن جدید صادر می‌شود
        """
    )
    def post(self, request):
        serializer = ChangePasswordSerializer(data=request.data, context={'request': request})
        if not serializer.is_valid():
            logger.warning(f"Failed password change attempt for user: {request.user.phone_number}")
            return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)

        user = request.user
        user.set_password(serializer.validated_data['new_password'])
        user.save(update_fields=['password'])

        # ابطال توکن قبلی و صدور توکن جدید (خروج از نشست‌های دیگر)
        Token.objects.filter(user=user).delete()
        token = Token.objects.create(user=user)

        logger.info(f"Password changed for user: {user.phone_number}")
        return Response({
            'message': 'رمز عبور با موفقیت تغییر کرد.',
            'token': token.key,
        })


@extend_schema(tags=['User'])
class UserProfileView(APIView):
    """نمایش و ویرایش پروفایل کاربر"""
    permission_classes = [IsAuthenticated]

    @extend_schema(
        responses={200: UserSerializer},
        description="دریافت اطلاعات پروفایل کاربر و موجودی توکن"
    )
    def get(self, request):
        serializer = UserSerializer(request.user)
        return Response(serializer.data)

    @extend_schema(
        request=UserSerializer,
        responses={200: UserSerializer},
        description="ویرایش اطلاعات پروفایل کاربر"
    )
    def patch(self, request):
        serializer = UserSerializer(request.user, data=request.data, partial=True)
        if serializer.is_valid():
            serializer.save()
            return Response(serializer.data)
        return Response(serializer.errors, status=status.HTTP_400_BAD_REQUEST)


# ==================== Equipment Views ====================

@extend_schema(tags=['Equipment'])
@extend_schema_view(
    list=extend_schema(description="دریافت لیست دستگاه‌های ورزشی کاربر"),
    create=extend_schema(description="ایجاد دستگاه ورزشی جدید"),
    retrieve=extend_schema(description="دریافت جزئیات یک دستگاه"),
    update=extend_schema(description="ویرایش کامل دستگاه"),
    partial_update=extend_schema(description="ویرایش جزئی دستگاه"),
    destroy=extend_schema(description="حذف دستگاه"),
)
class EquipmentViewSet(viewsets.ModelViewSet):
    """مدیریت دستگاه‌های ورزشی"""
    serializer_class = EquipmentSerializer
    # فقط برای مستندسازی: get_queryset واقعی بر اساس کاربر فیلتر می‌کند
    # و هنگام ساخت schema (بدون request) قابل فراخوانی نیست.
    queryset = Equipment.objects.none()
    # کاربرِ شخصی (B2C) هم دستگاه دارد: نتیجهٔ اسکنِ باشگاهش. queryset روی خودِ
    # کاربر فیلتر است، پس دسترسی به دستگاهِ دیگران باز نمی‌شود.
    permission_classes = [IsCoachOrPersonal]

    def get_queryset(self):
        return Equipment.objects.filter(user=self.request.user)

    def perform_create(self, serializer):
        serializer.save(user=self.request.user)


@extend_schema(tags=['Equipment'])
@extend_schema_view(
    list=extend_schema(description="دریافت لیست دسته‌بندی‌های دستگاه (دسته‌های خود مربی + دسته‌های سراسری)"),
    create=extend_schema(description="ایجاد دسته‌بندی جدید (اختصاصی همین مربی)"),
)
class EquipmentCategoryViewSet(viewsets.ModelViewSet):
    """مدیریت دسته‌بندی دستگاه‌ها

    هر مربی فقط دسته‌های خودش و دسته‌های سراسری (owner خالی) را می‌بیند؛
    ویرایش/حذف فقط روی دسته‌های خودش مجاز است.
    """
    serializer_class = EquipmentCategorySerializer
    # فقط برای مستندسازی: get_queryset واقعی بر اساس کاربر فیلتر می‌کند
    # و هنگام ساخت schema (بدون request) قابل فراخوانی نیست.
    queryset = EquipmentCategory.objects.none()
    permission_classes = [IsCoach]

    def get_queryset(self):
        qs = EquipmentCategory.objects.filter(
            Q(owner=self.request.user) | Q(owner__isnull=True)
        )
        if self.action in ('update', 'partial_update', 'destroy'):
            # دسته‌های سراسری فقط‌خواندنی هستند
            qs = qs.filter(owner=self.request.user)
        return qs

    def perform_create(self, serializer):
        serializer.save(owner=self.request.user)


