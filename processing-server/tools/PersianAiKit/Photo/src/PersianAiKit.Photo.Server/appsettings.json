{
  "Photo": {
    // پوشهٔ مدل‌ها؛ خالی ⇒ پوشهٔ models را خودش از کنارِ برنامه رو به بالا پیدا می‌کند
    "ModelsDir": "",
    // کتابخانهٔ عکس‌ها (data/docs)؛ خالی ⇒ پوشهٔ data کنارِ models
    "DataDir": "",
    // جدا از صدا (5600)، یابندهٔ رقیب (5610)، سرویسِ صدا (5620) و مشابه‌یاب (5650)
    "HttpPort": 5670,
    // false ⇒ فقط همین کامپیوتر. true ⇒ همهٔ شبکه — آن‌وقت حتماً ApiKey بگذارید
    "LanAccess": false,
    // خالی ⇒ بی‌کلید. پر ⇒ هر درخواستِ /api باید سرآیندِ X-Api-Key (یا ?key=) داشته باشد
    "ApiKey": "",
    // ضلعِ بلندترِ پیش‌نمایش (پیکسل). کمتر ⇒ لغزنده‌ها سریع‌تر
    "PreviewSide": 1600,
    // هم‌زمان چند پیش‌نمایش/خروجی ساخته شود (بیشتر ⇒ پردازندهٔ بیشتر)
    "MaxParallelRenders": 2,
    // هستهٔ پردازنده برای مدل‌ها؛ 0 ⇒ نصفِ هسته‌ها (کامپیوتر هنگامِ کار قفل نمی‌شود)
    "ModelThreads": 0,
    "Background": {
      // حذفِ پس‌زمینه با هوشِ مصنوعی (BiRefNet). سنگین: ~۶٫۵GB حافظهٔ آزاد و ~۷۰ ثانیه روی CPU.
      // حافظه کم باشد خودش اجرا نمی‌شود و روشِ سبک (بی مدل) به کار می‌رود. false ⇒ هرگز
      "Ai": true,
      "RequiredMemoryMB": 6500
    },
    // ویرایشگرِ هوشمند: هر سرویسِ سازگار با OpenAI که عکس می‌پذیرد. کلید خالی ⇒ فقط تنظیمِ خودکارِ رایگان (بی اینترنت)
    "Ai": {
      "BaseUrl": "https://openrouter.ai/api/v1",
      "ApiKey": "",
      // «auto-free» ⇒ مدل‌های بیناییِ رایگانِ OpenRouter. یا نامِ مدل‌ها با ویرگول، به ترتیب
      "Models": "auto-free",
      // ۱ ⇒ فقط پیشنهاد؛ ۲ ⇒ پیشنهاد + یک بار دیدنِ نتیجه و اصلاح
      "MaxRounds": 2,
      "ThumbSide": 512
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
