# NMarketing (UpMarket) — تنظیماتِ تولید روی سرورِ سایت (install.sh این را می‌سازد؛ بعدش دستی ویرایش کنید)
SECRET_KEY=__SECRET_KEY__
DEBUG=false
ALLOWED_HOSTS=__HOST__,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=http://__HOST__:8040,http://127.0.0.1:8040
TIME_ZONE=Asia/Tehran

# صف و کش
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# مسیرها
SQLITE_PATH=/var/www/NM/upmarket/data/db.sqlite3
MEDIA_ROOT=/var/www/NM/upmarket/backend/media
STATIC_ROOT=/var/www/NM/upmarket/backend/staticfiles
NM_DATA_DIR=/var/www/NM/upmarket/data
UP3D_ROOT=/var/www/NM/upmarket/up3d-engine
UP3D_DATA=/var/www/NM/upmarket/data/up3d
UP3D_SERVE_FILES=0

# نشانی‌های عمومی
PUBLIC_BASE_URL=http://__HOST__:8040
PANEL_URL=http://__HOST__:8040/panel
PAYMENT_CALLBACK_BASE=http://__HOST__:8040
WEBSITE_URL=http://127.0.0.1:3001
WEBSITE_REVALIDATE_SECRET=__REVALIDATE__

# ایمیل (sendmail محلی)
EMAIL_HOST=127.0.0.1
EMAIL_PORT=25
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=noreply@nmarketing.local

# هوشِ مصنوعی: متن از API (Metis)، تصویر/ویدیو روی سرورهای پردازش (GPU، بی‌IP)
AI_MODE_TEXT=api
AI_MODE_IMAGE=local
AI_MODE_VIDEO=local
COMFYUI_BASE_URL=agent://any
COMFYUI_TIMEOUT=1800
GPU_AUTO_UNLOAD=false
# AI_API_BASE_URL / AI_API_KEY در deploy/nm/ai.env (کامیت نمی‌شود)

# ابزارِ doctor (python manage.py doctor) پشتِ nginx
DOCTOR_BACKEND_URL=http://127.0.0.1:8040
DOCTOR_PANEL_URL=http://127.0.0.1:8040/panel/
DOCTOR_WEBSITE_URL=http://127.0.0.1:8040/

# ffmpeg 7 ایستا (install.sh نصبش می‌کند)
FFMPEG_BIN=/usr/local/bin/ffmpeg
FFPROBE_BIN=/usr/local/bin/ffprobe
