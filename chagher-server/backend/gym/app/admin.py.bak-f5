@admin.register(UnitEconomicsReport)
class UnitEconomicsReportAdmin(ReadOnlyAdminMixin, admin.ModelAdmin):
    """گزارش «هر برنامه چقدر برایمان تمام می‌شود».

    همان داده‌ی AIUsageLog است، ولی با یک جدول جمع‌بندی بالای صفحه که به
    تفکیک نوع عملیات نشان می‌دهد: میانگین توکن ورودی/خروجی، بهای تمام‌شده،
    قیمت فروش، و سود هر برنامه.
    """

    change_list_template = 'admin/app/uniteconomicsreport/change_list.html'
    list_display = [
        'created_at', 'operation', 'program_type', 'model_name',
        'input_tokens', 'output_tokens', 'cost', 'tokens_charged', 'revenue',
    ]
    list_filter = ['operation', 'program_type', 'model_name', 'created_at']
    date_hierarchy = 'created_at'
    list_per_page = 30

    # برچسب‌های خوانا برای ترکیب «عملیات + نوع برنامه»
    BUCKETS = [
        ('generate', 'both', 'برنامه ورزشی + غذایی'),
        ('generate', 'workout', 'فقط برنامه ورزشی'),
        ('generate', 'meal', 'فقط برنامه غذایی'),
        ('edit', None, 'ویرایش برنامه'),
    ]

    def changelist_view(self, request, extra_context=None):
        response = super().changelist_view(request, extra_context)

        # از همان queryset فیلترشده‌ی صفحه استفاده می‌کنیم تا جمع‌بندی با
        # فیلترهای کاربر (تاریخ، مدل، ...) هم‌خوان بماند.
        try:
            queryset = response.context_data['cl'].queryset
        except (AttributeError, KeyError):
            return response

        rows = []
        for operation, program_type, label in self.BUCKETS:
            bucket = queryset.filter(operation=operation)
            if program_type is not None:
                bucket = bucket.filter(program_type=program_type)
            agg = bucket.aggregate(
                n=Count('id'),
                tin=Sum('input_tokens'),
                tout=Sum('output_tokens'),
                cost=Sum('cost'),
                revenue=Sum('revenue'),
                charged=Sum('tokens_charged'),
            )
            count = agg['n'] or 0
            if not count:
                continue

            cost = agg['cost'] or Decimal('0')
            revenue = agg['revenue'] or Decimal('0')
            rows.append({
                'label': label,
                'count': f"{count:,}",
                'avg_in': _tokens((agg['tin'] or 0) / count),
                'avg_out': _tokens((agg['tout'] or 0) / count),
                'avg_cost': _toman(cost / count),
                'avg_tokens': _tokens((agg['charged'] or 0) / count),
                'avg_revenue': _toman(revenue / count),
                'avg_margin': _toman((revenue - cost) / count),
                'total_cost': _toman(cost),
                'total_revenue': _toman(revenue),
                'negative': revenue < cost,
            })

        totals = queryset.aggregate(
            n=Count('id'), cost=Sum('cost'), revenue=Sum('revenue'),
            tin=Sum('input_tokens'), tout=Sum('output_tokens'),
        )
        total_cost = totals['cost'] or Decimal('0')
        total_revenue = totals['revenue'] or Decimal('0')

        unit_price = AIUsageLog.current_token_unit_price()
        pricing_missing = not APIConfig.objects.filter(is_active=True).exclude(
            input_price_per_million=0, output_price_per_million=0
        ).exists()

        response.context_data['economics'] = {
            'rows': rows,
            'total_calls': f"{totals['n'] or 0:,}",
            'total_input': _tokens(totals['tin']),
            'total_output': _tokens(totals['tout']),
            'total_cost': _toman(total_cost),
            'total_revenue': _toman(total_revenue),
            'total_margin': _toman(total_revenue - total_cost),
            'token_unit_price': _toman(unit_price),
            'pricing_missing': pricing_missing,
        }
        return response


