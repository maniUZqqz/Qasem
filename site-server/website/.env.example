# آدرس بک‌اند جنگو — قیمت پلن‌ها از اینجا خوانده می‌شود
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000

# آدرس پنل محصول — دکمه‌های «ورود» و «شروع رایگان» به اینجا می‌روند
NEXT_PUBLIC_PANEL_URL=http://127.0.0.1:5173

# دامنه‌ی سایت — برای sitemap، robots و متادیتای SEO
NEXT_PUBLIC_SITE_URL=https://upmarket.ir

# کلیدی که جنگو با آن می‌گوید «این صفحه عوض شد، دوباره بخوانش».
# دست نزنید: start.bat خودش می‌سازدش و در .env.production.local می‌نویسد
# (نه اینجا و نه در .env.local — این دو کامیت می‌شوند).
# اگر خالی بماند، ویرایش‌های جنگو ادمین تا ۲ دقیقه بعد روی سایت می‌نشینند.
REVALIDATE_SECRET=
