class EquipmentAdmin(admin.ModelAdmin):
    """مدیریت دستگاه‌های ورزشی"""
    list_display = ['thumb_tag', 'name', 'user', 'category', 'muscle_group', 'created_at']
    list_filter = ['category', 'muscle_group', 'created_at']
    search_fields = ['name', 'user__phone_number', 'user__gym_name']
    autocomplete_fields = ['user', 'category', 'catalog']
    readonly_fields = ['created_at', 'updated_at', 'thumb_tag']
    list_per_page = 30

    @admin.display(description='عکس')
    def thumb_tag(self, obj):
        url = obj.image.url if obj.image else (
            obj.catalog.display_image_url() if obj.catalog_id and obj.catalog else None)
        if not url:
            return '—'
        return format_html('<img src="{}" style="height:46px;border-radius:6px">', url)
    list_per_page = 25


