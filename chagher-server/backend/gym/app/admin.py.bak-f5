    actions = ['make_public']

    @admin.action(description='سراسری‌کردن (برای همهٔ مربی‌ها)')
    def make_public(self, request, queryset):
        n = queryset.update(is_public=True, owner=None)
        self.message_user(request, '%d حرکت سراسری شد.' % n)
    search_fields = ['external_id', 'name', 'name_fa', 'equipment_fa', 'target_fa']
    readonly_fields = ['created_at', 'updated_at', 'media_preview']
    list_per_page = 50

    @admin.display(description='مدیا', boolean=True)
    def has_media(self, obj):
        return bool(obj.gif)

    @admin.display(description='پیش‌نمایش')
    def media_preview(self, obj):
        if not obj.gif:
            return 'گیفی آپلود نشده است.'
        try:
            return format_html('<img src="{}" style="max-width:360px;border-radius:8px" />', obj.gif.url)
        except Exception:
            return obj.gif.name


