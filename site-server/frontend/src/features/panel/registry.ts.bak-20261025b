import type { IconName } from "../../components/Icon";

/**
 * فهرستِ منوی پنل — تنها منبعِ حقیقت.
 *
 * کلیدِ دسته‌ها و صفحه‌ها با `backend/apps/panel/registry.py` یکی است؛ سرور با
 * همین کلیدها می‌گوید کدام صفحه روشن است (`GET /panel/flags/`) و اینجا
 * می‌گوییم هر کلید کجای منو، با چه برچسب و آیکونی، و به کدام آدرس می‌رود.
 *
 * سایدبار از همین فهرست ساخته می‌شود؛ زبانه‌های درونِ قاب‌ها (فروشگاه، محصول،
 * فروش، کمپین‌ها) فهرستِ خودشان را دارند و فقط کلید را از اینجا قرض می‌گیرند.
 */

export type SectionKey =
  | "home"
  | "store"
  | "market"
  | "sales"
  | "content"
  | "settings"
  | "product"
  | "admin"
  | "tools";

export type PanelSection = {
  key: SectionKey;
  /** سرِ گروه در سایدبار — و کلیدِ ذخیره‌ی باز/بسته در localStorage «nav-groups». */
  title: string;
  /** صفحه‌هایش به فروشگاهِ فعال نیاز دارند (`to(storeId)`). */
  storeScoped?: boolean;
  /** فقط برای کارکنان کشیده می‌شود؛ سرور هم جداگانه چک می‌کند. */
  staffOnly?: boolean;
  /** گروهی در سایدبار ندارد (داشبورد جداگانه می‌آید؛ صفحه‌ی محصول فقط زبانه است). */
  menu?: false;
};

export type PanelPage = {
  key: string;
  section: SectionKey;
  label: string;
  icon: IconName;
  /** آدرسِ مطلق، یا تابعی از شناسه (فروشگاه — یا محصول برای صفحه‌ی محصول). */
  to: string | ((id: string) => string);
  end?: boolean;
  staffOnly?: boolean;
  /** در سایدبار نیاید (فقط زبانه‌ی درونِ قاب است). */
  menu?: false;
  /** صفحه‌ی جنگو: با پلِ ورود در زبانه‌ی تازه باز می‌شود، نه با NavLink. */
  external?: true;
};

